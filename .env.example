# Resend API Key for handling trade & commodity enquiries
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender email address configured in Resend (e.g., onboarding@resend.dev or your custom domain)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Notification recipient email address where commodity inquiries will be delivered
ENQUIRY_RECIPIENT_EMAIL=enquiry@shivsahajaoverseas.com

# Public Site URL for canonical URLs and SEO
PUBLIC_SITE_URL=https://shivsahajaoverseas.com
