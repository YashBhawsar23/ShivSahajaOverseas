---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import { CERTIFICATE_SLOTS, type CertificateItem } from '../../config/site';

interface Props {
  certificates?: CertificateItem[];
}

const { certificates = CERTIFICATE_SLOTS } = Astro.props;
const hasAnyImage = certificates.some((cert) => Boolean(cert.image && cert.image.trim().length > 0));
---

<section class="py-16 sm:py-20 bg-[#F8F7F3] border-b border-[#E8E5DC]" aria-label="Official Company Certificates">
  <Container>
    <SectionHeader
      badge="Official Documentation"
      title="Company Registration Certificates"
      subtitle="Verified export accreditations and statutory trade licenses displayed in full clarity for international buyer due diligence."
    />

    <div
      id="cert-carousel-track"
      class="max-w-5xl mx-auto flex flex-nowrap overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 pt-1 pb-3 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden sm:flex-wrap sm:justify-center sm:gap-7 sm:overflow-visible sm:p-0"
    >
      {certificates.map((cert) => {
        const hasImage = Boolean(cert.image && cert.image.trim().length > 0);
        return (
          <article class="group w-[80%] flex-shrink-0 snap-start sm:flex-shrink sm:w-[calc((100%-1.75rem)/2-0.5px)] lg:w-[calc((100%-3.5rem)/3-0.5px)] bg-white rounded-2xl border-2 border-[#E8E5DC] hover:border-[#B69A63] shadow-sm hover:shadow-xl transition-all duration-300 p-3.5 sm:p-4 flex flex-col">
            {/* Outer Document Mat Frame */}
            <div
              class:list={[
                'relative aspect-[210/297] w-full rounded-xl overflow-hidden flex items-center justify-center',
                hasImage
                  ? 'bg-white border border-[#E8E5DC]'
                  : 'bg-gradient-to-b from-[#FAF9F5] to-[#F2EFE6] border border-dashed border-[#B69A63]/60',
              ]}
            >
              {hasImage ? (
                <button
                  type="button"
                  class="cert-zoom-trigger w-full h-full block cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B69A63] relative"
                  data-cert-src={cert.image}
                  data-cert-title={cert.title}
                  data-cert-alt={cert.alt || cert.title}
                  aria-label={`View full size clear image of ${cert.title}`}
                >
                  <img
                    src={cert.image}
                    alt={cert.alt || cert.title}
                    width="1785"
                    height="2526"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain bg-white p-1 transition-transform duration-300 group-hover:scale-[1.015]"
                  />
                </button>
              ) : (
                <div class="w-full h-full p-4 flex flex-col items-center justify-center text-center relative select-none">
                  {/* Subtle Institutional Corner Borders */}
                  <span class="absolute top-2.5 left-2.5 w-3.5 h-3.5 border-t-2 border-l-2 border-[#B69A63]/55 rounded-tl-xs" aria-hidden="true"></span>
                  <span class="absolute top-2.5 right-2.5 w-3.5 h-3.5 border-t-2 border-r-2 border-[#B69A63]/55 rounded-tr-xs" aria-hidden="true"></span>
                  <span class="absolute bottom-2.5 left-2.5 w-3.5 h-3.5 border-b-2 border-l-2 border-[#B69A63]/55 rounded-bl-xs" aria-hidden="true"></span>
                  <span class="absolute bottom-2.5 right-2.5 w-3.5 h-3.5 border-b-2 border-r-2 border-[#B69A63]/55 rounded-br-xs" aria-hidden="true"></span>

                  <span class="px-2.5 py-0.5 rounded-full bg-[#102C50]/8 text-[#102C50] text-[10px] font-bold uppercase tracking-widest mb-4 border border-[#102C50]/10">
                    Frame {cert.slotNumber}
                  </span>

                  <div class="w-14 h-14 rounded-2xl bg-white border border-[#E8E5DC] shadow-sm flex items-center justify-center text-[#B69A63] mb-3.5 group-hover:scale-105 group-hover:border-[#B69A63]/50 transition-all">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>

                  <p class="text-xs font-bold text-[#102C50] tracking-tight">
                    Certificate Frame
                  </p>
                  <p class="text-[11px] text-slate-500 mt-1 max-w-[16ch] leading-snug">
                    Reserved for high-resolution certificate image
                  </p>
                </div>
              )}
            </div>

            {/* Frame Label Plate */}
            <div class="pt-3.5 px-1 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-sm sm:text-base font-bold text-[#102C50] leading-snug">
                  {cert.title}
                </h3>
                <p class="text-[11px] text-slate-500 mt-0.5 font-medium">
                  {cert.subtitle}
                </p>
              </div>

              <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="font-mono text-slate-400">#{cert.slotNumber}</span>
                {!hasImage && (
                  <span class="inline-flex items-center gap-1 font-semibold text-[#91753C]">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B69A63]"></span>
                    Awaiting Upload
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/* Mobile Horizontal Carousel Controls (matches homepage pattern) */}
    {certificates.length > 1 && (
      <div class="mt-4 flex items-center justify-center gap-4 sm:hidden" aria-label="Certificate carousel controls">
        <button
          type="button"
          id="cert-carousel-prev"
          aria-label="Previous certificate"
          disabled
          class="w-10 h-10 rounded-full bg-white border border-[#E8E5DC] text-[#102C50] shadow-sm flex items-center justify-center hover:border-[#B69A63] hover:bg-[#102C50] hover:text-white transition-all cursor-pointer disabled:opacity-35 disabled:pointer-events-none flex-shrink-0"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="flex flex-col items-center gap-1.5">
          <div class="flex items-center gap-2" id="cert-carousel-dots" role="tablist" aria-label="Select certificate">
            {certificates.map((cert, idx) => (
              <button
                type="button"
                data-cert-dot={idx}
                aria-label={`Show ${cert.title}`}
                aria-current={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'cert-carousel-dot h-2 rounded-full transition-all duration-300 cursor-pointer',
                  idx === 0 ? 'w-6 bg-[#102C50]' : 'w-2 bg-[#B69A63]/40 hover:bg-[#B69A63]',
                ]}
              />
            ))}
          </div>
          <span class="text-[11px] font-semibold text-slate-500 tracking-wide">
            <span id="cert-carousel-index" class="font-bold text-[#102C50]">1</span> / {certificates.length} &bull; Swipe or tap
          </span>
        </div>

        <button
          type="button"
          id="cert-carousel-next"
          aria-label="Next certificate"
          class="w-10 h-10 rounded-full bg-white border border-[#E8E5DC] text-[#102C50] shadow-sm flex items-center justify-center hover:border-[#B69A63] hover:bg-[#102C50] hover:text-white transition-all cursor-pointer disabled:opacity-35 disabled:pointer-events-none flex-shrink-0"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    )}
  </Container>

  <!-- Full-Resolution Certificate Lightbox Modal (only rendered when uploaded images exist) -->
  {hasAnyImage && (
    <div
      id="cert-lightbox"
      class="hidden fixed inset-0 z-[100] bg-[#0A1C33]/90 backdrop-blur-sm p-4 sm:p-8 flex items-center justify-center"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cert-lightbox-title"
    >
      <div class="relative max-w-4xl w-full max-h-[92vh] bg-white rounded-2xl shadow-2xl border border-[#B69A63]/40 overflow-hidden flex flex-col">
        <div class="flex items-center justify-between px-5 py-3.5 bg-[#102C50] text-white border-b border-[#B69A63]/30">
          <p id="cert-lightbox-title" class="text-sm sm:text-base font-bold text-[#CBB482] truncate pr-4"></p>
          <button
            type="button"
            id="cert-lightbox-close"
            aria-label="Close certificate preview"
            class="p-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-[#183B63] transition-colors cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div id="cert-lightbox-body" class="p-4 sm:p-6 bg-[#F8F7F3] overflow-auto flex items-center justify-center flex-1"></div>
      </div>
    </div>
  )}
</section>

<script>
  function setupCertificateLightbox() {
    const triggers = document.querySelectorAll('.cert-zoom-trigger');
    const modal = document.getElementById('cert-lightbox');
    const modalBody = document.getElementById('cert-lightbox-body');
    const modalTitle = document.getElementById('cert-lightbox-title');
    const closeBtn = document.getElementById('cert-lightbox-close');

    if (!modal || !modalBody || !modalTitle || !triggers.length || modal.dataset.lightboxBound === 'true') return;
    modal.dataset.lightboxBound = 'true';

    function closeModal() {
      modal?.classList.add('hidden');
      if (modalBody) modalBody.innerHTML = '';
      document.body.style.overflow = '';
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const src = el.dataset.certSrc;
        if (!src) return;
        const img = document.createElement('img');
        img.src = src;
        img.alt = el.dataset.certAlt || '';
        img.className = 'max-w-full max-h-[76vh] w-auto h-auto object-contain rounded-lg shadow-md bg-white';
        modalBody.innerHTML = '';
        modalBody.appendChild(img);
        modalTitle.textContent = el.dataset.certTitle || 'Official Certificate';
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }

  function setupCertificateCarousel() {
    const track = document.getElementById('cert-carousel-track');
    const prevBtn = document.getElementById('cert-carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('cert-carousel-next') as HTMLButtonElement | null;
    const indexEl = document.getElementById('cert-carousel-index');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.cert-carousel-dot'));

    if (!track || track.dataset.carouselBound === 'true') return;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(':scope > article'));
    if (slides.length <= 1) return;

    track.dataset.carouselBound = 'true';
    let activeIndex = 0;
    let rafPending = false;
    let isProgrammaticScroll = false;
    let programmaticTimer: ReturnType<typeof setTimeout> | null = null;

    function updateControls(idx: number) {
      activeIndex = idx;
      if (indexEl) indexEl.textContent = String(idx + 1);
      if (prevBtn) prevBtn.disabled = idx <= 0;
      if (nextBtn) nextBtn.disabled = idx >= slides.length - 1;

      dots.forEach((dot, i) => {
        const isCurrent = i === idx;
        dot.setAttribute('aria-current', isCurrent ? 'true' : 'false');
        dot.classList.toggle('w-6', isCurrent);
        dot.classList.toggle('bg-[#102C50]', isCurrent);
        dot.classList.toggle('w-2', !isCurrent);
        dot.classList.toggle('bg-[#B69A63]/40', !isCurrent);
        dot.classList.toggle('hover:bg-[#B69A63]', !isCurrent);
      });
    }

    function goToSlide(idx: number) {
      if (!track) return;
      const clamped = Math.max(0, Math.min(slides.length - 1, idx));
      const trackRect = track.getBoundingClientRect();
      const slideRect = slides[clamped].getBoundingClientRect();
      const targetLeft = track.scrollLeft + (slideRect.left - trackRect.left);

      isProgrammaticScroll = true;
      if (programmaticTimer) clearTimeout(programmaticTimer);
      programmaticTimer = setTimeout(() => {
        isProgrammaticScroll = false;
      }, 550);

      updateControls(clamped);
      track.scrollTo({ left: targetLeft, behavior: 'smooth' });
    }

    function detectNearestSlide() {
      if (!track || isProgrammaticScroll) return;
      const trackCenter = track.getBoundingClientRect().left + track.clientWidth / 2;
      let bestIdx = 0;
      let bestDist = Infinity;

      slides.forEach((slide, i) => {
        const rect = slide.getBoundingClientRect();
        const center = rect.left + rect.width / 2;
        const dist = Math.abs(center - trackCenter);
        if (dist < bestDist) {
          bestDist = dist;
          bestIdx = i;
        }
      });

      if (bestIdx !== activeIndex) {
        updateControls(bestIdx);
      }
    }

    track.addEventListener(
      'touchstart',
      () => {
        isProgrammaticScroll = false;
        if (programmaticTimer) clearTimeout(programmaticTimer);
      },
      { passive: true }
    );

    track.addEventListener('scrollend', () => {
      isProgrammaticScroll = false;
      if (programmaticTimer) clearTimeout(programmaticTimer);
      detectNearestSlide();
    });

    track.addEventListener(
      'scroll',
      () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(() => {
          detectNearestSlide();
          rafPending = false;
        });
      },
      { passive: true }
    );

    prevBtn?.addEventListener('click', () => goToSlide(activeIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(activeIndex + 1));

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => goToSlide(idx));
    });

    updateControls(0);
  }

  function initCertificateFrames() {
    setupCertificateLightbox();
    setupCertificateCarousel();
  }

  initCertificateFrames();
  document.addEventListener('astro:page-load', initCertificateFrames);
</script>
