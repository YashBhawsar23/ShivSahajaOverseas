---
interface Props {
  variant?: 'light' | 'dark';
  layout?: 'horizontal' | 'stacked';
  showTagline?: boolean;
  class?: string;
}

const {
  variant = 'dark',
  layout = 'horizontal',
  showTagline = false,
  class: className = '',
} = Astro.props;

// 'light' variant = White & Gold graphics intended for dark navy surfaces (Header/Footer)
// 'dark' variant = Original Dark Navy (#0B2A4E) & Gold (#A68853) graphics for light surfaces
const isLightInk = variant === 'light';

const emblemSrc = isLightInk ? '/images/logo-emblem-dark.svg' : '/images/logo-emblem.svg';
const wordmarkSrc = isLightInk ? '/images/logo-wordmark-dark.svg' : '/images/logo-wordmark.svg';
const fullStackedSrc = isLightInk ? '/images/logo-official-dark.svg' : '/images/logo-official.svg';
const subtitleColor = isLightInk ? 'text-[#CBB482]/90' : 'text-slate-600';
---

<a
  href="/"
  class:list={[
    'inline-flex items-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B69A63] rounded-lg notranslate',
    layout === 'stacked' ? 'flex-col items-start p-1' : 'gap-2 sm:gap-3 p-0.5 sm:p-1',
    className,
  ]}
  aria-label="Shivsahaja Overseas — Home"
  translate="no"
>
  {layout === 'stacked' ? (
    <img
      src={fullStackedSrc}
      alt="Shivsahaja Overseas — Global Trade | Trusted Partner | Borderless Growth"
      width="970"
      height="768"
      loading="eager"
      decoding="sync"
      class="w-48 sm:w-56 h-auto transition-transform duration-300 group-hover:scale-[1.02]"
    />
  ) : (
    <>
      <img
        src={emblemSrc}
        alt=""
        width="776"
        height="479"
        loading="eager"
        decoding="sync"
        class="h-[30px] sm:h-11 w-auto flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
      />
      <div class="flex flex-col items-start leading-none min-w-0">
        <img
          src={wordmarkSrc}
          alt="Shivsahaja Overseas"
          width="970"
          height="179"
          loading="eager"
          decoding="sync"
          class="h-[21px] sm:h-8 w-auto flex-shrink-0"
        />
        {showTagline && (
          <span
            class:list={[
              'text-[6.5px] min-[390px]:text-[7.5px] sm:text-[9px] tracking-[0.12em] min-[390px]:tracking-[0.16em] uppercase font-medium mt-1 whitespace-nowrap',
              subtitleColor,
            ]}
          >
            Global Trade | Trusted Partner | Borderless Growth
          </span>
        )}
      </div>
    </>
  )}
</a>
