---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'outline-light' | 'gold' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  disabled?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel,
  id,
  disabled = false,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed select-none';

const sizeStyles = {
  sm: 'text-xs px-3.5 py-1.5 gap-1.5',
  md: 'text-sm px-5 py-2.5 gap-2',
  lg: 'text-base px-6 py-3.5 gap-2.5',
};

const variantStyles = {
  primary: 'bg-[#102C50] text-white hover:bg-[#183B63] shadow-sm hover:shadow active:scale-[0.99] focus-visible:ring-[#102C50]',
  secondary: 'bg-[#183B63] text-white hover:bg-[#102C50] shadow-sm focus-visible:ring-[#183B63]',
  gold: 'bg-[#B69A63] text-[#102C50] hover:bg-[#CBB482] font-bold shadow-sm hover:shadow active:scale-[0.99] focus-visible:ring-[#B69A63]',
  outline: 'border border-[#102C50] text-[#102C50] hover:bg-[#102C50] hover:text-white focus-visible:ring-[#102C50]',
  'outline-light': 'border border-white/40 text-white hover:bg-white/15 hover:border-[#B69A63] hover:text-white backdrop-blur-sm focus-visible:ring-white',
  ghost: 'text-[#102C50] hover:bg-slate-100 focus-visible:ring-[#102C50]',
};
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={target === '_blank' ? rel || 'noopener noreferrer' : rel}
      class:list={[baseStyles, sizeStyles[size], variantStyles[variant], className]}
      id={id}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      class:list={[baseStyles, sizeStyles[size], variantStyles[variant], className]}
      id={id}
    >
      <slot />
    </button>
  )
}
