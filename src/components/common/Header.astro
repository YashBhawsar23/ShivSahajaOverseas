---
import BrandLogo from './BrandLogo.astro';
import Button from './Button.astro';
import Container from './Container.astro';
import LanguageSelector from './LanguageSelector.astro';
import { SITE_CONFIG } from '../../config/site';
import { categories } from '../../content.config';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  label: string;
  href: string;
  hidden?: boolean;
  children?: { label: string; href: string }[];
}

const allNavItems: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  {
    label: 'Products',
    href: '/products',
    children: categories.map((c) => ({
      label: c.name,
      href: `/products/category/${c.id}`,
    })),
  },
  { label: 'Global Trade', href: '/trade' },
  { label: 'Import', href: '/import', hidden: !SITE_CONFIG.features.enableImport },
  { label: 'Certifications', href: '/certifications' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Contact', href: '/contact' },
];

const navItems = allNavItems.filter((item) => !item.hidden);

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 bg-[#102C50]/95 backdrop-blur-md border-b border-[#B69A63]/20 shadow-md transition-all duration-200">
  <!-- Top Utility Bar: Trade credentials & International inquiries -->
  <div class="bg-[#0A1C33] text-slate-300 text-xs py-1.5 border-b border-[#183B63] hidden md:block">
    <Container class="flex justify-between items-center text-[11px] tracking-wide">
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Exporting Premium Agro Commodities Globally
        </span>
        <span class="text-slate-400">|</span>
        <span class="text-slate-400">Standard: APEDA &bull; FSSAI &bull; Spices Board Compliant</span>
      </div>
      <div class="flex items-center gap-4 text-slate-300">
        <span>India Head Office &bull; Worldwide Port Shipments</span>
        <a href="/contact" class="text-[#CBB482] hover:text-white transition-colors underline-offset-2 hover:underline">
          Quick Trade Desk &rarr;
        </a>
        <span class="text-slate-500">|</span>
        <LanguageSelector variant="topbar" />
      </div>
    </Container>
  </div>

  <!-- Main Navigation Bar -->
  <div class="py-2.5 sm:py-3.5">
    <Container class="flex items-center justify-between">
      <!-- Company Logo -->
      <BrandLogo variant="light" />

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navItems.map((item) => {
          const active = isActive(item.href);
          if (item.children) {
            return (
              <div class="relative group">
                <a
                  href={item.href}
                  class:list={[
                    'px-3 py-2 rounded-md text-sm font-medium transition-all duration-150 inline-flex items-center gap-1.5 cursor-pointer',
                    active
                      ? 'text-white bg-[#183B63] border-b-2 border-[#B69A63] shadow-inner'
                      : 'text-slate-200 hover:text-white hover:bg-[#183B63]/60 group-hover:text-white group-hover:bg-[#183B63]/60'
                  ]}
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  <span>{item.label}</span>
                  <svg
                    class="w-3.5 h-3.5 text-[#CBB482] transition-transform duration-200 group-hover:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                {/* Dropdown Card */}
                <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-200 ease-out transform -translate-y-1 group-hover:translate-y-0 absolute top-full left-0 pt-2 w-60 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
                  <div class="bg-white rounded-xl shadow-2xl border border-[#E8E5DC] py-1.5 overflow-hidden ring-1 ring-black/5">
                    {item.children.map((child) => {
                      const isChildActive = currentPath === child.href;
                      return (
                        <a
                          href={child.href}
                          class:list={[
                            'block px-4 py-2.5 text-xs sm:text-sm transition-colors text-left',
                            isChildActive
                              ? 'bg-[#F8F7F3] text-[#102C50] font-bold border-l-4 border-[#B69A63]'
                              : 'text-slate-700 hover:bg-[#F8F7F3] hover:text-[#102C50] hover:font-semibold'
                          ]}
                        >
                          {child.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          }
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-md text-sm font-medium transition-all duration-150',
                active
                  ? 'text-white bg-[#183B63] border-b-2 border-[#B69A63] shadow-inner'
                  : 'text-slate-200 hover:text-white hover:bg-[#183B63]/60'
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA & Mobile Cluster -->
      <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
        <!-- Always-Visible Header Language Selector (Mobile & Desktop) -->
        <LanguageSelector variant="header" />

        <!-- Request Quote CTA (Tablet & Desktop) -->
        <div class="hidden sm:block">
          <Button href="/contact" variant="gold" size="sm" class="shadow-md">
            Request Quote
          </Button>
        </div>

        <!-- Mobile Menu Trigger -->
        <button
          type="button"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label="Toggle navigation menu"
          class="lg:hidden p-1.5 sm:p-2 text-slate-200 hover:text-white hover:bg-[#183B63] rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B69A63]"
        >
          <svg class="w-6 h-6 menu-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 menu-close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </Container>
  </div>

  <!-- Mobile Drawer / Dropdown (Language picker removed as requested) -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden bg-[#0A1C33] border-t border-[#183B63] shadow-2xl transition-all duration-300"
  >
    <Container class="py-4 space-y-1">
      {navItems.map((item) => {
        const active = isActive(item.href);
        if (item.children) {
          return (
            <div class="space-y-1">
              <button
                type="button"
                id="mobile-products-toggle"
                aria-expanded="false"
                aria-label="Toggle products categories"
                class:list={[
                  'w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer select-none',
                  active
                    ? 'bg-[#183B63] text-white font-semibold border-l-4 border-[#B69A63]'
                    : 'text-slate-200 hover:bg-[#183B63]/60 hover:text-white'
                ]}
              >
                <span>{item.label}</span>
                <svg
                  class="w-4 h-4 transition-transform duration-200 mobile-chevron text-[#CBB482]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <div id="mobile-products-menu" class="hidden pl-4 pr-1 py-1 space-y-1 border-l-2 border-[#B69A63]/30 ml-4">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block px-3 py-2 rounded text-xs transition-colors',
                      currentPath === child.href
                        ? 'text-white font-bold bg-[#183B63]'
                        : 'text-slate-300 hover:text-white hover:bg-[#183B63]/40'
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
              active
                ? 'bg-[#183B63] text-white font-semibold border-l-4 border-[#B69A63]'
                : 'text-slate-200 hover:bg-[#183B63]/60 hover:text-white'
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}

      <div class="pt-3 pb-1 border-t border-[#183B63]/80 mt-2">
        <Button href="/contact" variant="gold" size="md" class="w-full text-center">
          Request Trade Quote
        </Button>
      </div>
    </Container>
  </div>
</header>

<script>
  function setupHeader() {
    // 1. Mobile menu toggle
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const openIcon = btn?.querySelector('.menu-open-icon');
    const closeIcon = btn?.querySelector('.menu-close-icon');

    if (btn && drawer) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isExpanded));
        drawer.classList.toggle('hidden');
        openIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
      });
    }

    // 2. Mobile products sub-menu toggle
    const prodToggle = document.getElementById('mobile-products-toggle');
    const prodMenu = document.getElementById('mobile-products-menu');
    const chevron = prodToggle?.querySelector('.mobile-chevron');

    if (prodToggle && prodMenu) {
      prodToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isExpanded = prodToggle.getAttribute('aria-expanded') === 'true';
        prodToggle.setAttribute('aria-expanded', String(!isExpanded));
        prodMenu.classList.toggle('hidden');
        chevron?.classList.toggle('rotate-180');
      });
    }
  }

  // Run on first load and client navigations
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
