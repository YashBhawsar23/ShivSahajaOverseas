---
import { POPULAR_LANGUAGES, ALL_LANGUAGES } from '../../utils/languages';

interface Props {
  variant?: 'topbar' | 'header' | 'mobile';
  class?: string;
}

const { variant = 'topbar', class: className = '' } = Astro.props;
---

<div class:list={[
  'relative language-selector-root',
  variant === 'mobile' ? 'block w-full' : 'inline-block',
  className
]}>
  <!-- Trigger Button -->
  {variant === 'topbar' && (
    <button
      type="button"
      class="language-trigger-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-[#102C50] text-slate-200 hover:text-white border border-[#B69A63]/30 hover:border-[#B69A63] transition-colors cursor-pointer select-none"
      aria-haspopup="dialog"
      aria-expanded="false"
      title="Translate Website (130+ Languages)"
    >
      <span class="text-xs">🌐</span>
      <span class="current-lang-label">Language</span>
      <svg class="w-3 h-3 text-[#CBB482] transition-transform duration-200 chevron-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  )}

  {variant === 'header' && (
    <button
      type="button"
      class="language-trigger-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#183B63] text-white hover:bg-[#204975] border border-[#B69A63]/40 shadow-sm transition-all cursor-pointer select-none"
      aria-haspopup="dialog"
      aria-expanded="false"
      title="Translate Website (130+ Languages)"
    >
      <span>🌐</span>
      <span class="current-lang-label font-bold">EN</span>
      <svg class="w-3.5 h-3.5 text-[#CBB482] transition-transform duration-200 chevron-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  )}

  {variant === 'mobile' && (
    <button
      type="button"
      class="language-trigger-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-sm font-medium bg-[#102C50] text-white border border-[#B69A63]/40 transition-colors cursor-pointer select-none"
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <div class="flex items-center gap-2">
        <span class="text-base">🌐</span>
        <span class="font-semibold text-slate-200">Select Language:</span>
        <span class="current-lang-label text-[#CBB482] font-bold">English</span>
      </div>
      <svg class="w-4 h-4 text-[#CBB482] transition-transform duration-200 chevron-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  )}

  <!-- Language Dropdown Modal -->
  <div
    class:list={[
      'language-dropdown-modal hidden absolute top-full mt-2 bg-[#0A1C33] border border-[#B69A63]/50 rounded-2xl shadow-2xl p-4 z-[100] text-slate-200 ring-1 ring-black/40 notranslate',
      variant === 'mobile' ? 'left-0 right-0 w-full' : 'right-0 w-80 sm:w-96 max-w-[92vw]'
    ]}
    role="dialog"
    aria-label="Google Translate Language Selector"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-3 border-b border-[#183B63]">
      <div class="flex items-center gap-2">
        <span class="text-base">🌐</span>
        <div>
          <h4 class="text-xs font-bold text-white uppercase tracking-wider">Google Translate</h4>
          <p class="text-[10px] text-slate-400">130+ Global Languages Available</p>
        </div>
      </div>
      <button
        type="button"
        class="close-modal-btn p-1 text-slate-400 hover:text-white rounded-md transition-colors"
        aria-label="Close language selector"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Live Search Input -->
    <div class="mt-3 relative">
      <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </span>
      <input
        type="text"
        class="lang-search-input w-full pl-9 pr-3 py-1.5 bg-[#102C50] border border-[#183B63] focus:border-[#B69A63] rounded-lg text-xs text-white placeholder-slate-400 focus:outline-none transition-colors"
        placeholder="Search any language (e.g., Arabic, Spanish, French)..."
      />
    </div>

    <!-- Quick Trade Partners Strip -->
    <div class="quick-trade-section mt-3">
      <span class="text-[10px] font-bold text-[#CBB482] uppercase tracking-wider block mb-1.5">
        Major Export Partners
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
        {POPULAR_LANGUAGES.map((lang) => (
          <button
            type="button"
            class="lang-select-btn px-2.5 py-1.5 rounded-md text-xs font-medium bg-[#102C50] hover:bg-[#183B63] text-slate-200 hover:text-white border border-[#183B63] hover:border-[#B69A63]/60 transition-all flex items-center gap-1.5 text-left cursor-pointer"
            data-lang={lang.code}
            data-name={lang.name}
          >
            <span>{lang.flag}</span>
            <span class="truncate">{lang.name}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Full 130+ Language List -->
    <div class="mt-3 pt-2 border-t border-[#183B63]">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
          All Languages ({ALL_LANGUAGES.length})
        </span>
        <button
          type="button"
          class="reset-lang-btn text-[10px] text-[#CBB482] hover:text-white font-semibold hover:underline cursor-pointer"
        >
          Reset to English
        </button>
      </div>

      <div class="all-languages-list max-h-48 overflow-y-auto space-y-0.5 pr-1 scrollbar-thin">
        {ALL_LANGUAGES.map((lang) => (
          <button
            type="button"
            class="lang-select-btn w-full px-2.5 py-1.5 rounded text-xs text-slate-300 hover:text-white hover:bg-[#183B63] flex items-center justify-between transition-colors text-left cursor-pointer group"
            data-lang={lang.code}
            data-name={lang.name}
            data-search={`${lang.name} ${lang.native} ${lang.code}`.toLowerCase()}
          >
            <div class="flex items-center gap-1.5">
              <span>{lang.flag || '🌐'}</span>
              <span class="font-medium">{lang.name}</span>
            </div>
            <span class="text-[11px] text-slate-400 group-hover:text-[#CBB482] font-mono">
              {lang.native}
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function setupLanguageSelectors() {
    const roots = document.querySelectorAll('.language-selector-root');
    if (!roots.length) return;

    // Helper: read current googtrans cookie
    function getCurrentLang(): string {
      const match = document.cookie.match(/(?:^|;\s*)googtrans=([^;]+)/);
      if (match && match[1]) {
        // format is usually /en/ar or /auto/ar
        const parts = decodeURIComponent(match[1]).split('/');
        return parts[parts.length - 1] || 'en';
      }
      return 'en';
    }

    // Helper: Update trigger button labels
    function updateLabels(langCode: string, langName?: string) {
      roots.forEach((root) => {
        const label = root.querySelector('.current-lang-label');
        if (label) {
          if (label.textContent?.length === 2) {
            // Short variant (e.g. EN)
            label.textContent = langCode.toUpperCase();
          } else {
            label.textContent = langName || langCode.toUpperCase();
          }
        }
      });
    }

    // Initial label sync
    const initialLang = getCurrentLang();
    if (initialLang && initialLang !== 'en') {
      const matchBtn = document.querySelector(`.lang-select-btn[data-lang="${initialLang}"]`);
      const name = matchBtn?.getAttribute('data-name');
      updateLabels(initialLang, name || undefined);
    }

    // Translate trigger function
    function applyTranslation(langCode: string, langName?: string) {
      const host = window.location.hostname;
      const cookieValue = `/en/${langCode}`;
      
      // Set cookie for host and domain
      document.cookie = `googtrans=${cookieValue}; path=/;`;
      if (host.includes('.')) {
        document.cookie = `googtrans=${cookieValue}; path=/; domain=.${host};`;
      }

      // Trigger Google Translate select element if present
      const teCombo = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
      if (teCombo) {
        teCombo.value = langCode;
        if (typeof (teCombo as any).onchange === 'function') {
          (teCombo as any).onchange();
        }
        teCombo.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Update labels
      updateLabels(langCode, langName);

      // If Google Translate select wasn't ready or if user is resetting, reload to ensure complete translation
      if (!teCombo || langCode === 'en') {
        window.location.reload();
      }
    }

    // Setup each selector root
    roots.forEach((root) => {
      const triggerBtn = root.querySelector('.language-trigger-btn');
      const modal = root.querySelector('.language-dropdown-modal');
      const closeBtn = root.querySelector('.close-modal-btn');
      const searchInput = root.querySelector('.lang-search-input') as HTMLInputElement | null;
      const langBtns = root.querySelectorAll('.lang-select-btn');
      const resetBtn = root.querySelector('.reset-lang-btn');
      const chevron = root.querySelector('.chevron-icon');
      const quickSection = root.querySelector('.quick-trade-section');

      if (!triggerBtn || !modal) return;

      function openModal() {
        modal?.classList.remove('hidden');
        triggerBtn?.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
        searchInput?.focus();
      }

      function closeModal() {
        modal?.classList.add('hidden');
        triggerBtn?.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
        if (searchInput) searchInput.value = '';
        filterLanguages('');
      }

      triggerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !modal.classList.contains('hidden');
        // Close any other open modals first
        document.querySelectorAll('.language-dropdown-modal').forEach((m) => m.classList.add('hidden'));
        document.querySelectorAll('.chevron-icon').forEach((c) => c.classList.remove('rotate-180'));
        if (!isOpen) {
          openModal();
        } else {
          closeModal();
        }
      });

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeModal();
      });

      // Filter languages as user types
      function filterLanguages(term: string) {
        const q = term.trim().toLowerCase();
        const listItems = root.querySelectorAll('.all-languages-list .lang-select-btn');
        if (quickSection) {
          (quickSection as HTMLElement).style.display = q ? 'none' : 'block';
        }
        listItems.forEach((item) => {
          const s = (item.getAttribute('data-search') || '').toLowerCase();
          (item as HTMLElement).style.display = !q || s.includes(q) ? 'flex' : 'none';
        });
      }

      searchInput?.addEventListener('input', (e) => {
        filterLanguages((e.target as HTMLInputElement).value);
      });

      // Language item click
      langBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const code = btn.getAttribute('data-lang') || 'en';
          const name = btn.getAttribute('data-name') || code;
          applyTranslation(code, name);
          closeModal();
        });
      });

      // Reset to English
      resetBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const host = window.location.hostname;
        document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
        if (host.includes('.')) {
          document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.${host};`;
        }
        applyTranslation('en', 'English');
        closeModal();
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.language-selector-root')) {
        document.querySelectorAll('.language-dropdown-modal').forEach((m) => m.classList.add('hidden'));
        document.querySelectorAll('.chevron-icon').forEach((c) => c.classList.remove('rotate-180'));
      }
    });
  }

  setupLanguageSelectors();
  document.addEventListener('astro:page-load', setupLanguageSelectors);
</script>