---
interface Props {
  phoneNumber?: string;
  defaultMessage?: string;
}

const {
  phoneNumber = '919977028934',
  defaultMessage = 'Hello Shivsahaja Overseas, I am interested in sourcing agricultural export commodities. Please share your product catalogue and price quotations.',
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<div
  id="whatsapp-floating-widget"
  class="fixed z-50 transition-all duration-300 right-4 sm:right-6 bottom-5 sm:bottom-6 group"
>
  <!-- Desktop Interactive Tooltip Pill -->
  <div class="hidden sm:flex items-center gap-2 absolute right-full mr-3.5 top-1/2 -translate-y-1/2 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full shadow-lg border border-[#E8E5DC] text-xs font-bold text-[#102C50] pointer-events-none whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200">
    <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
    <span>Chat with Trade Desk</span>
  </div>

  <!-- WhatsApp Action Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp with Shivsahaja Overseas (+91 99770 28934)"
    class="whatsapp-btn relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-[0_4px_20px_rgba(37,211,102,0.45)] hover:shadow-[0_6px_28px_rgba(37,211,102,0.65)] hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#25D366]/40"
  >
    <!-- Attention-Grabbing Radar Wave -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-75 animate-ping-slow pointer-events-none"></span>

    <!-- Live Online Indicator Dot -->
    <span class="absolute top-0.5 right-0.5 sm:top-1 sm:right-1 flex h-3.5 w-3.5 pointer-events-none">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-200 border-2 border-white"></span>
    </span>

    <!-- Authentic WhatsApp Icon -->
    <svg
      class="w-7 h-7 sm:w-8 sm:h-8 fill-white relative z-10 drop-shadow-sm"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z" />
      <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 001.333 4.993L2 22l5.233-1.237a9.994 9.994 0 004.779 1.217h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.669-1.037-5.176-2.925-7.062A9.925 9.925 0 0012.012 2zm0 18.234h-.003a8.28 8.28 0 01-4.223-1.152l-.303-.18-3.111.737.747-3.033-.197-.314a8.257 8.257 0 01-1.267-4.298c.001-4.571 3.725-8.291 8.303-8.291 2.214 0 4.295.863 5.86 2.428a8.243 8.243 0 012.425 5.864c-.001 4.572-3.725 8.291-8.298 8.291z" />
    </svg>
  </a>
</div>

<style>
  @keyframes ping-slow {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    70% {
      transform: scale(1.45);
      opacity: 0;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  @keyframes gentle-wobble {
    0%, 100% { transform: rotate(0deg); }
    2% { transform: rotate(10deg); }
    4% { transform: rotate(-8deg); }
    6% { transform: rotate(6deg); }
    8% { transform: rotate(-4deg); }
    10% { transform: rotate(0deg); }
  }

  .animate-ping-slow {
    animation: ping-slow 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .whatsapp-btn {
    animation: gentle-wobble 6s ease-in-out infinite;
  }

  /* When the page has a sticky mobile bottom bar, lift WhatsApp button above it on mobile */
  :global(body.has-mobile-bottom-bar) #whatsapp-floating-widget {
    bottom: 4.75rem;
  }
  @media (min-width: 1024px) {
    :global(body.has-mobile-bottom-bar) #whatsapp-floating-widget {
      bottom: 1.5rem;
    }
  }
</style>
