---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';

const certifications = [
  {
    code: 'APEDA',
    title: 'Agricultural & Processed Food Export Authority',
    authority: 'Ministry of Commerce & Industry, Govt. of India',
    desc: 'Compliance with export promotion standards, HortiNet farm traceability, and packaging protocols for agricultural commodities.',
  },
  {
    code: 'FSSAI',
    title: 'Food Safety and Standards Authority of India',
    authority: 'Ministry of Health and Family Welfare',
    desc: 'Adherence to comprehensive national food hygiene, physical-chemical purity limits, and sanitary manufacturing standards.',
  },
  {
    code: 'SPICES BOARD',
    title: 'Spices Board of India Compliance',
    authority: 'Ministry of Commerce & Industry, Govt. of India',
    desc: 'Quality certification and mandatory testing for aflatoxins, pesticide residues, and adulterant screening across spice export batches.',
  },
  {
    code: 'DGFT / IEC',
    title: 'Import Export Code (IEC) Registration',
    authority: 'Director General of Foreign Trade, India',
    desc: 'Authorized international trade registration validating legal export status across all Indian maritime ports and airports.',
  },
];
---

<section class="py-20 bg-[#F8F7F3] border-b border-[#E8E5DC]" aria-label="Certifications & Regulatory Alignment">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B69A63]/15 text-[#91753C] text-xs font-bold uppercase tracking-wider mb-3">
          Compliance &amp; Quality Protocols
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#102C50] tracking-tight">
          Standardized Quality &amp; Regulatory Benchmarks
        </h2>
        <p class="mt-2 text-base text-slate-600 max-w-2xl">
          Operating under strict alignment with Indian statutory authorities and global food safety protocols to ensure hassle-free customs clearance.
        </p>
      </div>

      <Button href="/certifications" variant="outline" size="md" class="self-start md:self-auto flex-shrink-0">
        Review All Certifications &rarr;
      </Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {certifications.map((cert) => (
        <div class="p-6 rounded-2xl bg-white border border-[#E8E5DC] shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#102C50] text-[#B69A63] font-bold text-xs flex items-center justify-center mb-4 tracking-wider group-hover:bg-[#183B63] transition-colors">
              {cert.code}
            </div>

            <h3 class="text-base font-bold text-[#102C50] group-hover:text-[#B69A63] transition-colors leading-snug">
              {cert.title}
            </h3>

            <span class="block text-[11px] font-semibold text-slate-400 mt-1 uppercase tracking-wide">
              {cert.authority}
            </span>

            <p class="mt-3 text-xs text-slate-600 leading-relaxed">
              {cert.desc}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-bold text-emerald-700">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Statutory Export Alignment
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
