---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
---

<section class="relative bg-[#102C50] text-white overflow-hidden min-h-[85vh] flex items-center">
  <!-- Background Image with Directional Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=2000&q=80"
      alt="Global maritime container port and cargo ship"
      class="w-full h-full object-cover object-center opacity-55 filter brightness-95 contrast-115"
      loading="eager"
    />
    <!-- Directional Asymmetric Gradient: Solid Navy on Left for text readability, Translucent on Right for maritime visibility -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#102C50] via-[#102C50]/85 to-[#102C50]/35 lg:via-[#102C50]/75 lg:to-transparent"></div>
    <!-- Subtle Grid Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(#B69A63_1px,transparent_1px)] [background-size:24px_24px] opacity-10"></div>
  </div>

  <Container class="relative z-10 py-20 lg:py-28">
    <div class="max-w-3xl">
      <!-- Tagline Pill -->
      <div class="inline-flex items-center gap-2 sm:gap-2.5 px-4 py-2 sm:px-5 sm:py-2 rounded-2xl sm:rounded-full bg-[linear-gradient(135deg,#D9C38F_0%,#B69A63_55%,#DFC896_100%)] border border-[#F1DFB4] text-[#0A1C33] text-[11px] sm:text-[13px] font-extrabold tracking-[0.08em] sm:tracking-[0.14em] uppercase mb-6 max-w-full shadow-[0_8px_28px_rgba(182,154,99,0.35),inset_0_1px_0_rgba(255,255,255,0.45)]">
        <span class="w-2 h-2 rounded-full bg-[#0A1C33] flex-shrink-0" aria-hidden="true"></span>
        <span class="inline-flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-0.5 leading-snug">
          <span class="whitespace-nowrap">Global Trade</span>
          <span class="opacity-65 font-semibold" aria-hidden="true">|</span>
          <span class="whitespace-nowrap">Trusted Partner</span>
          <span class="hidden min-[520px]:inline opacity-65 font-semibold" aria-hidden="true">|</span>
          <span class="whitespace-nowrap">Borderless Growth</span>
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.12]">
        Connecting Global Markets Through Trusted Trade
      </h1>

      <!-- Supporting Text (Exact Match to Prompt) -->
      <p class="mt-6 text-lg sm:text-xl text-slate-200 leading-relaxed max-w-2xl font-light">
        Your trusted partner for sourcing and supplying quality agricultural commodities and products across international markets.
      </p>

      <!-- Action Buttons -->
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <Button href="/products" variant="gold" size="lg" class="shadow-xl">
          Explore Product Catalogue
        </Button>
        <Button href="/contact" variant="outline-light" size="lg" class="shadow-sm">
          Request Commercial Quote
        </Button>
        <a href="/about" class="text-sm font-semibold text-[#CBB482] hover:text-white transition-colors inline-flex items-center gap-1.5 ml-2">
          Discover Our Heritage &rarr;
        </a>
      </div>

      <!-- Trust Metrics Strip -->
      <div class="mt-14 pt-8 border-t border-slate-700/60 grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white">6</div>
          <div class="text-xs text-[#CBB482] font-semibold mt-0.5">Commodity Sectors</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Fruits, Vegetables, Spices, Grains &amp; Cotton</div>
        </div>

        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white">100%</div>
          <div class="text-xs text-[#CBB482] font-semibold mt-0.5">Inspection Passed</div>
          <div class="text-[11px] text-slate-400 mt-0.5">SGS &amp; Intertek Quality Protocols</div>
        </div>

        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white">Incoterms</div>
          <div class="text-xs text-[#CBB482] font-semibold mt-0.5">FOB &bull; CIF &bull; CFR</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Direct Sea &amp; Air Logistics</div>
        </div>

        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white">Certified</div>
          <div class="text-xs text-[#CBB482] font-semibold mt-0.5">Export Compliant</div>
          <div class="text-[11px] text-slate-400 mt-0.5">APEDA, FSSAI &amp; DGFT Standards</div>
        </div>
      </div>
    </div>
  </Container>
</section>
