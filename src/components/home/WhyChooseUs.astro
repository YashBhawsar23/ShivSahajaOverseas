---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';

const advantages = [
  {
    title: 'Zero Compromise On Quality',
    desc: 'Every consignment is pre-inspected by accredited third-party surveyors (SGS, Intertek, Geo-Chem). We test for pesticide residues, aflatoxins, moisture thresholds, and genetic purity.',
  },
  {
    title: 'Strategic Port Proximity',
    desc: 'Located with direct transit access to India’s major western ports (JNPT, Mundra, and Hazira), minimizing inland transit times and port demurrage risks.',
  },
  {
    title: 'Flexible International Incoterms',
    desc: 'We support FOB, CIF, CFR, and DAP delivery terms with clear freight rate benchmarking and transparent ocean carrier selections.',
  },
  {
    title: 'Customer-Centric Account Execution',
    desc: 'You receive dedicated trade desk updates, real-time container stuffing photographs, sample retention records, and seamless shipping document delivery.',
  },
];
---

<section class="py-20 bg-gradient-to-b from-[#102C50] to-[#0A1C33] text-white border-b border-[#183B63]" aria-label="Why Choose Shivsahaja Overseas">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Heading & Guarantee -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#183B63] border border-[#B69A63]/30 text-[#CBB482] text-xs font-bold uppercase tracking-wider">
          Competitive Edge
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Why Global Importers Partner with <span class="text-[#B69A63]">Shivsahaja</span>
        </h2>

        <p class="text-base text-slate-300 leading-relaxed font-light">
          International agricultural trade demands dependable partners who understand international food safety regulations, adhere strictly to contractual timelines, and protect buyers from quality defaults.
        </p>

        <div class="p-6 rounded-2xl bg-[#183B63]/60 border border-[#B69A63]/20 backdrop-blur-md space-y-3">
          <div class="flex items-center gap-2 text-sm font-bold text-[#CBB482]">
            <svg class="w-5 h-5 text-[#B69A63]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Our Quality Pledge
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            We provide verified Certificate of Analysis (COA) and complete container stuffing photos with every single export bill of lading.
          </p>
        </div>

        <div>
          <Button href="/contact" variant="gold" size="md">
            Start a Trade Dialogue &rarr;
          </Button>
        </div>
      </div>

      <!-- Right Feature Cards -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {advantages.map((adv, idx) => (
          <div class="p-6 rounded-2xl bg-[#183B63]/40 border border-slate-700 hover:border-[#B69A63] transition-all duration-300 space-y-3">
            <span class="text-xs font-bold text-[#B69A63] uppercase tracking-wider block font-mono">
              [ 0{idx + 1} / Advantage ]
            </span>
            <h3 class="text-lg font-bold text-white leading-snug">
              {adv.title}
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              {adv.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
