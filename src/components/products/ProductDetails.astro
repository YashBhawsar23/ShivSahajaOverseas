---
import type { ProductEntry } from '../../utils/products';
import { getCategoryDetails } from '../../utils/products';

interface Props {
  product: ProductEntry;
  class?: string;
}

const { product, class: className = '' } = Astro.props;
const { data } = product;
const categoryInfo = getCategoryDetails(data.category);

const specEntries = Object.entries(data.specifications || {});
---

<div class:list={['space-y-8', className]}>
  <!-- Header info -->
  <div>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <a
        href={`/products/category/${data.category}`}
        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#102C50] text-white tracking-wide uppercase hover:bg-[#183B63] transition-colors"
      >
        {categoryInfo?.name || data.category}
      </a>
      
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 uppercase tracking-wide">
        Trade Type: {data.tradeType.toUpperCase()}
      </span>

      {data.hsCode && (
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-mono bg-slate-100 text-slate-700 border border-slate-200">
          HS Code: {data.hsCode}
        </span>
      )}
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#102C50] tracking-tight leading-tight">
      {data.name}
    </h1>

    <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
      {data.description}
    </p>
  </div>

  <!-- Key Trade Metrics Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 sm:gap-4">
    <div class="bg-white p-4 rounded-xl border border-[#E8E5DC] shadow-sm">
      <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Country of Origin</span>
      <span class="mt-1 block text-sm sm:text-base font-bold text-[#102C50]">{data.origin}</span>
    </div>

    {data.grade && (
      <div class="bg-white p-4 rounded-xl border border-[#E8E5DC] shadow-sm">
        <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Grading Standard</span>
        <span class="mt-1 block text-sm sm:text-base font-bold text-[#102C50]">{data.grade}</span>
      </div>
    )}

    {data.moq && (
      <div class="bg-white p-4 rounded-xl border border-[#E8E5DC] shadow-sm">
        <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Min. Order Qty (MOQ)</span>
        <span class="mt-1 block text-sm sm:text-base font-bold text-[#102C50]">{data.moq}</span>
      </div>
    )}
  </div>

  <!-- Technical Specifications Table -->
  {specEntries.length > 0 && (
    <div class="bg-white rounded-2xl border border-[#E8E5DC] shadow-sm overflow-hidden">
      <div class="px-6 py-4 bg-[#102C50] text-white flex items-center justify-between">
        <h2 class="text-sm sm:text-base font-bold tracking-wide uppercase">
          Technical Parameters & Analysis
        </h2>
        <span class="text-xs text-[#CBB482] font-semibold">Laboratory Tested</span>
      </div>

      <div class="divide-y divide-slate-100">
        {specEntries.map(([key, value], idx) => (
          <div class:list={['px-6 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between text-sm gap-1', idx % 2 === 0 ? 'bg-[#F8F7F3]/40' : 'bg-white']}>
            <span class="font-semibold text-slate-700">{key}</span>
            <span class="font-medium text-[#102C50] text-right font-mono sm:font-sans">{value}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Packaging & Shipping Details -->
  {data.packaging && (
    <div class="bg-white p-6 rounded-2xl border border-[#E8E5DC] shadow-sm space-y-3">
      <h3 class="text-base font-bold text-[#102C50] flex items-center gap-2">
        <svg class="w-5 h-5 text-[#B69A63]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        Export Packaging & Container Logistics
      </h3>
      <p class="text-sm text-slate-600 leading-relaxed">
        {data.packaging}
      </p>
      <div class="pt-2 text-xs text-slate-500 flex flex-wrap gap-x-4 gap-y-1">
        <span>&bull; Palletized / Slip-sheet options on request</span>
        <span>&bull; Private label buyer stenciling supported</span>
        <span>&bull; Desiccant packs & liner bags included</span>
      </div>
    </div>
  )}

  <!-- Commercial Trade Terms & Assurance -->
  <div class="bg-gradient-to-br from-[#102C50] to-[#183B63] text-white p-6 rounded-2xl shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h4 class="text-base font-bold text-[#CBB482]">Supported Incoterms 2020</h4>
        <p class="text-xs text-slate-200 mt-1">FOB (Nhava Sheva / Mundra / Chennai), CIF, CFR target destination port.</p>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold">
        <span class="px-2.5 py-1 rounded bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482]">SGS / Intertek Inspection</span>
      </div>
    </div>
  </div>
</div>
