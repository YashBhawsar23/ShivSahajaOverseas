---
import type { ProductEntry } from '../../utils/products';
import { getCategoryDetails } from '../../utils/products';
import { SITE_CONFIG } from '../../config/site';

interface Props {
  product: ProductEntry;
  class?: string;
}

const { product, class: className = '' } = Astro.props;
const { data } = product;
const categoryInfo = getCategoryDetails(data.category);
const { enableImport } = SITE_CONFIG.features;
---

<div class:list={['space-y-6 sm:space-y-8', className]}>
  <!-- Header info -->
  <div>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <a
        href={`/products/category/${data.category}`}
        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#102C50] text-white tracking-wide uppercase hover:bg-[#183B63] transition-colors"
      >
        {categoryInfo?.name || data.category}
      </a>
      
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 uppercase tracking-wide">
        Trade Type: {enableImport ? data.tradeType.toUpperCase() : 'EXPORT READY'}
      </span>
    </div>

    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#102C50] tracking-tight leading-tight">
      {data.name}
    </h1>

    <p class="mt-3 sm:mt-4 text-sm sm:text-lg text-slate-600 leading-relaxed">
      {data.description}
    </p>

    <!-- Mobile Quick Quotation Jump -->
    <div class="mt-4 flex items-center gap-2.5 lg:hidden">
      <a
        href="#product-inquiry"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-[#B69A63] hover:bg-[#A38752] text-[#102C50] text-xs font-bold shadow-sm transition-colors flex-1 uppercase tracking-wider"
      >
        <span>Request Quotation</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href={`/contact?commodity=${encodeURIComponent(data.name)}`}
        class="inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-[#102C50] hover:bg-[#183B63] text-white text-xs font-semibold transition-colors"
      >
        Direct Contact
      </a>
    </div>
  </div>

  <!-- Key Trade Metrics Cards -->
  {(data.grade || data.moq) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
      {data.grade && (
        <div class="bg-white p-3.5 sm:p-4 rounded-xl border border-[#E8E5DC] shadow-sm">
          <span class="block text-[10px] sm:text-[11px] font-bold text-slate-400 uppercase tracking-wider">Grading Standard</span>
          <span class="mt-1 block text-sm sm:text-base font-bold text-[#102C50]">{data.grade}</span>
        </div>
      )}

      {data.moq && (
        <div class="bg-white p-3.5 sm:p-4 rounded-xl border border-[#E8E5DC] shadow-sm border-l-4 border-l-[#B69A63]">
          <span class="block text-[10px] sm:text-[11px] font-bold text-slate-400 uppercase tracking-wider">Min. Order Qty (MOQ)</span>
          <span class="mt-1 block text-sm sm:text-base font-bold text-[#102C50]">{data.moq}</span>
        </div>
      )}
    </div>
  )}

  <!-- Packaging & Shipping Details -->
  {data.packaging && (
    <div class="bg-white p-4 sm:p-6 rounded-2xl border border-[#E8E5DC] shadow-sm space-y-3">
      <h3 class="text-sm sm:text-base font-bold text-[#102C50] flex items-center gap-2">
        <svg class="w-5 h-5 text-[#B69A63] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        Export Packaging & Container Logistics
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
        {data.packaging}
      </p>
      <div class="pt-2 text-xs text-slate-500 flex flex-wrap gap-x-4 gap-y-1">
        <span>&bull; Palletized / Slip-sheet options on request</span>
        <span>&bull; Private label buyer stenciling supported</span>
        <span>&bull; Desiccant packs & liner bags included</span>
      </div>
    </div>
  )}

  <!-- Commercial Trade Terms & Assurance -->
  <div class="bg-gradient-to-br from-[#102C50] to-[#183B63] text-white p-4 sm:p-6 rounded-2xl shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
      <div>
        <h4 class="text-sm sm:text-base font-bold text-[#CBB482]">Supported Incoterms 2020</h4>
        <p class="text-xs text-slate-200 mt-1">FOB (Nhava Sheva / Mundra / Chennai), CIF, CFR target destination port.</p>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold flex-shrink-0">
        <span class="px-2.5 py-1 rounded bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482]">SGS / Intertek Inspection</span>
      </div>
    </div>
  </div>
</div>
