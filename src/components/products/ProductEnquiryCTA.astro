---
import Button from '../common/Button.astro';

interface Props {
  productName: string;
  moq?: string;
  hsCode?: string;
  class?: string;
}

const { productName, moq, hsCode, class: className = '' } = Astro.props;

const defaultPhone = '919977028934';
const waMessage = hsCode
  ? `Hello Shivsahaja Overseas, I am interested in a commercial price quotation for ${productName} (HS Code: ${hsCode}). Please share current FOB/CIF availability, export grading, and pricing.`
  : `Hello Shivsahaja Overseas, I am interested in a commercial price quotation for ${productName}. Please share current FOB/CIF availability, export grading, and pricing.`;
const whatsappUrl = `https://wa.me/${defaultPhone}?text=${encodeURIComponent(waMessage)}`;
---

<div class:list={['bg-white rounded-2xl border-2 border-[#B69A63]/30 p-6 sm:p-7 shadow-lg relative overflow-hidden', className]}>
  <div class="absolute -right-12 -top-12 w-32 h-32 bg-[#B69A63]/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="relative z-10 space-y-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-[#102C50] text-[#CBB482] uppercase tracking-wider">
      <span>Official Trade Inquiry</span>
    </div>

    <h3 class="text-xl font-bold text-[#102C50] leading-snug">
      Request Price Quotation for {productName}
    </h3>

    <p class="text-xs text-slate-600 leading-relaxed">
      Submit your target delivery port, volume requirements, and packaging specifications to receive a formal Proforma Invoice and CIF/FOB quote.
    </p>

    {moq && (
      <div class="text-xs text-slate-700 bg-[#F8F7F3] p-2.5 rounded-lg border border-[#E8E5DC]">
        <span class="font-bold text-[#102C50]">Standard Minimum Order:</span> {moq}
      </div>
    )}

    <div class="pt-2 space-y-2.5">
      <Button
        href={`/contact?commodity=${encodeURIComponent(productName)}`}
        variant="gold"
        size="md"
        class="w-full text-center shadow-md justify-center"
      >
        Request Formal Quotation
      </Button>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] cursor-pointer"
        aria-label={`Inquire about ${productName} on WhatsApp`}
      >
        <svg class="w-4 h-4 fill-white flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z" />
          <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 001.333 4.993L2 22l5.233-1.237a9.994 9.994 0 004.779 1.217h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.669-1.037-5.176-2.925-7.062A9.925 9.925 0 0012.012 2zm0 18.234h-.003a8.28 8.28 0 01-4.223-1.152l-.303-.18-3.111.737.747-3.033-.197-.314a8.257 8.257 0 01-1.267-4.298c.001-4.571 3.725-8.291 8.303-8.291 2.214 0 4.295.863 5.86 2.428a8.243 8.243 0 012.425 5.864c-.001 4.572-3.725 8.291-8.298 8.291z" />
        </svg>
        <span>Inquire on WhatsApp</span>
      </a>

      <a
        href={`mailto:enquiry@shivsahajaoverseas.com?subject=Inquiry%20for%20${encodeURIComponent(productName)}`}
        class="block text-center text-xs text-slate-500 hover:text-[#102C50] transition-colors py-1"
      >
        Direct Email: <span class="font-semibold text-slate-700">enquiry@shivsahajaoverseas.com</span>
      </a>
    </div>

    <!-- Assurance Points -->
    <div class="pt-4 border-t border-slate-100 grid grid-cols-2 gap-2 text-[11px] text-slate-500">
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Response &le; 24 Hours</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Pre-shipment Inspection</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Global Port Logistics</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>FSSAI / APEDA Certified</span>
      </div>
    </div>
  </div>
</div>
