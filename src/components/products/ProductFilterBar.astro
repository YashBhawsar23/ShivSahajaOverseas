---
import { SITE_CONFIG } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const { enableImport } = SITE_CONFIG.features;
---

<div class:list={['bg-white p-4 sm:p-5 rounded-2xl border border-[#E8E5DC] shadow-sm mb-8', className]} id="filter-bar">
  <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
    <!-- Live Search Input -->
    <div class="relative flex-1">
      <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </span>
      <input
        type="search"
        id="commodity-search"
        placeholder="Search commodity name, origin, specification, or HS code..."
        class="w-full pl-10 pr-4 py-2.5 bg-[#F8F7F3] border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#B69A63] focus:border-transparent transition"
        autocomplete="off"
      />
    </div>

    {enableImport && (
      <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0" id="trade-type-filters">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider whitespace-nowrap mr-1">
          Trade:
        </span>
        <button
          type="button"
          data-trade="all"
          class="trade-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#102C50] text-white transition-colors"
        >
          All
        </button>
        <button
          type="button"
          data-trade="export"
          class="trade-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors"
        >
          Export
        </button>
        <button
          type="button"
          data-trade="import"
          class="trade-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors"
        >
          Import
        </button>
        <button
          type="button"
          data-trade="both"
          class="trade-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors"
        >
          Both
        </button>
      </div>
    )}
  </div>

  <!-- Search counter feedback -->
  <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
    <div id="results-count-text">
      Showing all commodities
    </div>
    <button
      type="button"
      id="reset-filter-btn"
      class="text-[#B69A63] hover:text-[#91753C] font-semibold hidden transition-colors"
    >
      Clear Search &times;
    </button>
  </div>
</div>

<script>
  function setupProductFilters() {
    const searchInput = document.getElementById('commodity-search') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll('.trade-filter-btn');
    const resetBtn = document.getElementById('reset-filter-btn');
    const countText = document.getElementById('results-count-text');
    const articles = document.querySelectorAll<HTMLElement>('#product-grid article');

    if (!articles.length) return;

    let currentTrade = 'all';
    let searchQuery = '';
    let currentCategory = 'all';

    function applyFilters() {
      let visibleCount = 0;

      articles.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        const tradeType = card.dataset.tradeType || '';
        const category = card.dataset.category || '';

        const matchesQuery = !searchQuery || text.includes(searchQuery);
        const matchesTrade = currentTrade === 'all' || tradeType === currentTrade || tradeType === 'both';
        const matchesCategory = currentCategory === 'all' || category === currentCategory;

        if (matchesQuery && matchesTrade && matchesCategory) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countText) {
        countText.textContent = `Displaying ${visibleCount} of ${articles.length} commodities`;
      }

      if (resetBtn) {
        if (searchQuery || currentTrade !== 'all' || currentCategory !== 'all') {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });

    // Listen for category selection events from ProductCategoryNavigation
    window.addEventListener('filter-category', ((e: CustomEvent) => {
      currentCategory = e.detail?.category || 'all';
      applyFilters();
    }) as EventListener);

    // Check for category in URL parameters on initial load
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category');
    if (initialCategory) {
      currentCategory = initialCategory;
      applyFilters();
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-[#102C50]', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('bg-[#102C50]', 'text-white');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        currentTrade = (btn as HTMLElement).dataset.trade || 'all';
        applyFilters();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentTrade = 'all';
      currentCategory = 'all';
      filterBtns.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add('bg-[#102C50]', 'text-white');
          b.classList.remove('bg-slate-100', 'text-slate-700');
        } else {
          b.classList.remove('bg-[#102C50]', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
        }
      });
      // Notify navigation pills to reset to 'all'
      window.dispatchEvent(new CustomEvent('filter-category', { detail: { category: 'all' } }));
      applyFilters();
    });
  }

  setupProductFilters();
  document.addEventListener('astro:page-load', setupProductFilters);
</script>
