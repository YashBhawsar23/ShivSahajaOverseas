---
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import WhatsAppButton from '../components/common/WhatsAppButton.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  hasBottomBar?: boolean;
}

const { title, description, image, type = 'website', hasBottomBar = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
    <slot name="head" />
  </head>
  <body class:list={[
    'flex flex-col min-h-screen bg-[#F8F7F3] text-slate-800 antialiased selection:bg-[#102C50] selection:text-white',
    { 'has-mobile-bottom-bar': hasBottomBar }
  ]}>
    <!-- Accessible Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-[#102C50] text-[#B69A63] font-bold rounded shadow-lg border border-[#B69A63]"
    >
      Skip to main content
    </a>

    <!-- Global Header -->
    <Header />

    <!-- Main Page Content -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Universal Sticky WhatsApp Inquiry Widget -->
    <WhatsAppButton />

    <!-- Lenis Smooth Momentum Scrolling -->
    <script>
      import Lenis from 'lenis';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          touchMultiplier: 1.5,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        // Smooth scroll for internal hash anchors
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (href && href !== '#' && document.querySelector(href)) {
              e.preventDefault();
              lenis.scrollTo(href, { offset: -70 });
            }
          });
        });

        document.addEventListener('astro:page-load', () => {
          lenis.resize();
        });
      }
    </script>
  </body>
</html>
