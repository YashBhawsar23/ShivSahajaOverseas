---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/common/Button.astro';

const values = [
  {
    title: 'Trade Integrity & Transparency',
    desc: 'We honor contract terms without deviation in specifications, weight, or shipping schedules. Honest communication is the bedrock of our global partnerships.',
  },
  {
    title: 'Uncompromised Quality Benchmark',
    desc: 'Every commodity is inspected and certified by accredited independent laboratories (SGS / Intertek), guaranteeing that destination port customs encounter zero discrepancies.',
  },
  {
    title: 'Farmer Empowerment & Sustainability',
    desc: 'By working directly with farming cooperatives and ginners, we eliminate exploitative middlemen and ensure fair remuneration for rural Indian growers.',
  },
  {
    title: 'Supply Chain Reliability',
    desc: 'Unbroken logistics management—from farmgate collection and temperature-controlled pre-cooling to scheduled container vessel loading at India’s premier ports.',
  },
];

const milestones = [
  {
    year: 'Direct Origin Sourcing',
    title: 'Agricultural Belts of Western & Central India',
    desc: 'Strategic partnerships established with farmers and ginning clusters across Maharashtra, Gujarat, Madhya Pradesh, and Andhra Pradesh.',
  },
  {
    year: 'Quality & Sorting',
    title: 'Multi-Stage Mechanical & Optical Cleaning',
    desc: 'Deployment of gravity separators and high-precision Sortex optical color sorters delivering up to 99.5% purity grades.',
  },
  {
    year: 'Port Operations',
    title: 'Strategic Maritime Logistics Gateways',
    desc: 'Direct logistical linkage to JNPT (Nhava Sheva), Mundra Port, and Hazira Port, ensuring fast customs clearance and predictable voyage times.',
  },
  {
    year: 'Global Expansion',
    title: 'Borderless Commercial Growth',
    desc: 'Serving international buyers across the Middle East, Southeast Asia, Africa, Europe, and beyond under internationally recognized Incoterms.',
  },
];
---

<BaseLayout
  title="About Us | Corporate Profile & Heritage"
  description="Discover Shivsahaja Overseas: a premier Indian agricultural trading house bridging prime farming clusters with international commodity markets."
>
  <!-- Hero Banner -->
  <section class="py-20 bg-gradient-to-b from-[#102C50] to-[#183B63] text-white relative">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482] text-xs font-bold uppercase tracking-wider mb-4">
          Corporate Identity &bull; Trusted Partner
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          Pioneering Trust in International <span class="text-[#B69A63]">Agro Trade</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-200 leading-relaxed font-light">
          Shivsahaja Overseas is a dedicated Indian import-export enterprise committed to sourcing and exporting top-tier agricultural commodities, raw cotton, spices, grains, and farm produce to buyers worldwide.
        </p>
      </div>
    </Container>
  </section>

  <!-- Corporate Narrative -->
  <section class="py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B69A63]/10 text-[#91753C] text-xs font-bold uppercase tracking-wider">
            Our Purpose &amp; Philosophy
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#102C50] leading-tight">
            Built on Reliability, Sustained by Excellence
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            India is blessed with vast agro-ecological diversity, generating world-class cotton, vibrant spices, and wholesome grains. However, international buyers often face hurdles with inconsistent grading, unexpected delays, and documentation ambiguities.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Shivsahaja Overseas was established to address these precise challenges. We combine deep roots in rural Indian agricultural markets with modern corporate supply chain discipline, transparent contractual terms, and rigorous pre-shipment quality verification.
          </p>
          <div class="pt-2 flex items-center gap-4">
            <Button href="/products" variant="primary" size="md">
              Browse Commodity Catalogue
            </Button>
            <Button href="/contact" variant="outline" size="md">
              Inquire with Trade Desk
            </Button>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden shadow-lg border border-[#E8E5DC] aspect-4/5">
              <img
                src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&w=600&q=80"
                alt="Raw cotton bales and fiber processing"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="rounded-2xl overflow-hidden shadow-lg border border-[#E8E5DC] aspect-4/5 mt-8">
              <img
                src="https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=600&q=80"
                alt="Pure Indian spices and turmeric harvest"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Core Values -->
  <section class="py-20 bg-[#F8F7F3] border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Operating Philosophy"
        title="Our Core Values"
        subtitle="The enduring trade principles that govern every transaction, contract, and shipment."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((val, idx) => (
          <div class="p-6 rounded-2xl bg-white border border-[#E8E5DC] shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold text-[#B69A63] font-mono block mb-3 uppercase tracking-wider">
                [ Value 0{idx + 1} ]
              </span>
              <h3 class="text-lg font-bold text-[#102C50] mb-2 leading-snug">
                {val.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {val.desc}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-semibold text-slate-400">
              <span class="w-1.5 h-1.5 rounded-full bg-[#102C50]"></span>
              Corporate Standard
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Supply Chain Lifecycle -->
  <section class="py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Operational Architecture"
        title="How We Execute International Orders"
        subtitle="A synchronized four-stage supply chain ensuring total quality compliance."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
        {milestones.map((ms, idx) => (
          <div class="p-6 rounded-2xl bg-[#F8F7F3] border border-[#E8E5DC] relative">
            <div class="w-10 h-10 rounded-xl bg-[#102C50] text-[#B69A63] font-bold text-sm flex items-center justify-center mb-4">
              {idx + 1}
            </div>
            <span class="text-xs font-bold text-[#91753C] uppercase tracking-wider block mb-1">
              {ms.year}
            </span>
            <h3 class="text-base font-bold text-[#102C50] mb-2 leading-snug">
              {ms.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {ms.desc}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
