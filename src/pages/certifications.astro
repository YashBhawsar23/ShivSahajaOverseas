---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/common/Button.astro';

const standards = [
  {
    code: 'APEDA',
    title: 'Agricultural & Processed Food Products Export Development Authority',
    ministry: 'Ministry of Commerce & Industry, Government of India',
    scope: 'Registration and adherence to export quality norms, packaging requirements, and HortiNet traceability systems for fresh fruits, vegetables, and agro-commodities.',
    verificationStatus: 'Statutory Export Alignment',
  },
  {
    code: 'FSSAI',
    title: 'Food Safety and Standards Authority of India',
    ministry: 'Ministry of Health and Family Welfare, Government of India',
    scope: 'Comprehensive food safety compliance covering hygienic handling, physical-chemical specifications, maximum permissible additive limits, and non-adulteration safeguards.',
    verificationStatus: 'Food Safety Benchmark',
  },
  {
    code: 'SPICES BOARD',
    title: 'Spices Board of India Compliance Standards',
    ministry: 'Ministry of Commerce & Industry, Government of India',
    scope: 'Mandatory pre-export sampling and chemical analysis for aflatoxins, pesticide residues, and artificial dye markers (Sudan I-IV) across whole and ground spice consignments.',
    verificationStatus: 'Spices Export Compliance',
  },
  {
    code: 'DGFT / IEC',
    title: 'Director General of Foreign Trade – IEC Registration',
    ministry: 'Ministry of Commerce & Industry, Government of India',
    scope: 'Official Import Export Code (IEC) authorization confirming authorized commercial export entity status across all Indian maritime ports and inland container depots.',
    verificationStatus: 'DGFT Registered Entity',
  },
  {
    code: 'PLANT QUARANTINE',
    title: 'National Plant Protection Organization (NPPO / DPPQS)',
    ministry: 'Ministry of Agriculture and Farmers Welfare, India',
    scope: 'Official Phytosanitary Inspection and Phytosanitary Certificate (PSC) issuance guaranteeing absence of quarantine pests and foreign weed seeds.',
    verificationStatus: 'Official Quarantine Protocol',
  },
  {
    code: 'SURVEYOR SURVEYS',
    title: 'Independent Third-Party Verification (SGS / Intertek / Geo-Chem)',
    ministry: 'Accredited International Inspection Agencies',
    scope: 'Pre-shipment sampling, container inspection, gross/tare weight witnessing, and Certificate of Analysis (COA) issued according to buyer purchase order specifications.',
    verificationStatus: 'Independent Certification Available',
  },
];
---

<BaseLayout
  title="Certifications & Quality Compliance Framework"
  description="Review the regulatory credentials, food safety frameworks, and inspection protocols governing Shivsahaja Overseas international export shipments."
>
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-b from-[#102C50] to-[#183B63] text-white relative">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482] text-xs font-bold uppercase tracking-wider mb-4">
          Statutory Standards &bull; Zero Compromise
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          Quality Certifications &amp; <span class="text-[#B69A63]">Regulatory Adherence</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-200 leading-relaxed font-light">
          Operating in strict compliance with Indian statutory trade bodies and international food safety benchmarks to ensure complete confidence for overseas buyers.
        </p>
      </div>
    </Container>
  </section>

  <!-- Standards Grid -->
  <section class="py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Regulatory Framework"
        title="Statutory Standards Governing Our Exports"
        subtitle="We adhere strictly to statutory export norms established by the Government of India and international quarantine authorities."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {standards.map((std) => (
          <div class="p-7 rounded-2xl bg-[#F8F7F3] border border-[#E8E5DC] flex flex-col justify-between hover:border-[#B69A63] hover:shadow-lg transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-lg text-xs font-bold bg-[#102C50] text-[#CBB482] font-mono tracking-wider">
                  {std.code}
                </span>
                <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
                  {std.verificationStatus}
                </span>
              </div>

              <h3 class="text-lg font-bold text-[#102C50] mb-1.5 leading-snug">
                {std.title}
              </h3>

              <span class="block text-xs font-semibold text-[#91753C] mb-3">
                {std.ministry}
              </span>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {std.scope}
              </p>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-200/60 flex items-center gap-1.5 text-[11px] text-slate-500">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Export Documentation Dispatched with B/L</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Compliance Notice Card -->
      <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-[#102C50] text-white shadow-xl max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <h4 class="text-lg font-bold text-[#CBB482]">Need Certificate Copies for Bank L/C Verification?</h4>
          <p class="text-xs sm:text-sm text-slate-300">
            Official registration certificates and sample laboratory reports are provided directly to accredited commercial buyers.
          </p>
        </div>
        <Button href="/contact" variant="gold" size="md" class="flex-shrink-0">
          Request Compliance Documents &rarr;
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
