---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/common/Button.astro';

const exportSteps = [
  {
    step: '01',
    title: 'Trade Inquiry & Specification Alignment',
    desc: 'Buyer submits target commodity, required grade parameters (moisture, purity, count, brix), destination port, and desired delivery schedule. We issue a formal commercial quote.',
  },
  {
    step: '02',
    title: 'Contract & Financial Instrument',
    desc: 'Execution of international sales contract under agreed Incoterms 2020. Payment secured via Irrevocable Letter of Credit (L/C at sight) or advance Wire Transfer (T/T).',
  },
  {
    step: '03',
    title: 'Precision Sourcing & Packaging',
    desc: 'Commodity procured directly from contracted growers or ginners. Cleaned via gravity destoners and Sortex optical sorters. Packed in food-grade or buyer-branded packaging.',
  },
  {
    step: '04',
    title: 'Pre-Shipment Inspection',
    desc: 'Independent survey by internationally accredited inspection bodies (SGS, Intertek, or Geo-Chem) verifying gross/tare weight, moisture, purity, and container hygiene.',
  },
  {
    step: '05',
    title: 'Port Clearance & Vessel Loading',
    desc: 'Container transport to JNPT, Mundra, or Hazira. Indian Customs clearance, Phytosanitary certification, and prompt container loading aboard booked ocean liners.',
  },
  {
    step: '06',
    title: 'Document Dispatch & Tracking',
    desc: 'Immediate dispatch of original Bill of Lading (BL), Certificate of Origin (COO), Commercial Invoice, Packing List, Phytosanitary Certificate, and Insurance policy.',
  },
];

const ports = [
  {
    name: 'JNPT (Nhava Sheva Port, Mumbai)',
    location: 'Maharashtra, India',
    facilities: 'Largest container gateway in India; regular weekly feeder & direct line vessels to Gulf, Europe, and US.',
    cargoType: 'Dry containers, Flat rack cotton bales, Reefer containers',
  },
  {
    name: 'Mundra Port',
    location: 'Gujarat, India',
    facilities: 'Deep-draft commercial port with high-speed automated gantry cranes and extensive temperature-regulated cold storage.',
    cargoType: 'Grains, Oilseeds, Spices, Perishable fruits & vegetables',
  },
  {
    name: 'Hazira Port (Surat)',
    location: 'Gujarat, India',
    facilities: 'State-of-the-art container terminal close to southern Gujarat and northern Maharashtra agricultural heartlands.',
    cargoType: 'Agricultural produce, Cotton slivers, Food grain containers',
  },
  {
    name: 'Chennai / Cochin Ports',
    location: 'Southern India',
    facilities: 'Strategic maritime access points for South Indian spices, turmeric fingers, and specialized tropical commodities.',
    cargoType: 'Spices, Cardamom, South Indian grain varieties',
  },
];
---

<BaseLayout
  title="Export Capabilities & Global Port Logistics"
  description="Learn about Shivsahaja Overseas export solutions: seamless agro commodity sourcing, SGS inspection, customs clearance, and port logistics across India."
>
  <!-- Hero Section -->
  <section class="py-20 bg-gradient-to-b from-[#102C50] to-[#183B63] text-white relative">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482] text-xs font-bold uppercase tracking-wider mb-4">
          Global Supply Solutions
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          Reliable Export Sourcing from <span class="text-[#B69A63]">India to the World</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-200 leading-relaxed font-light">
          We specialize in managing end-to-end export logistics for international buyers, guaranteeing strict adherence to Incoterms, international sanitary regulations, and port schedules.
        </p>
      </div>
    </Container>
  </section>

  <!-- Export Workflow -->
  <section class="py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Execution Framework"
        title="Our 6-Stage Export Protocol"
        subtitle="A transparent, accountable workflow that eliminates operational delays and ensures contract compliance."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {exportSteps.map((step) => (
          <div class="p-7 rounded-2xl bg-[#F8F7F3] border border-[#E8E5DC] flex flex-col justify-between hover:border-[#B69A63] hover:shadow-lg transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-[#B69A63] font-mono">{step.step}</span>
                <span class="text-[11px] font-bold text-[#102C50] bg-white px-2.5 py-1 rounded border border-[#E8E5DC] uppercase">
                  Standard SOP
                </span>
              </div>
              <h3 class="text-lg font-bold text-[#102C50] mb-2 leading-snug">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {step.desc}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-slate-200/60 flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Standard Export Checkpoint
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Port Infrastructure -->
  <section class="py-20 bg-[#F8F7F3] border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Maritime Gateways"
        title="Primary Ports of Loading"
        subtitle="Strategic connectivity to India's premier deepwater maritime hubs guarantees frequent vessel sailings and competitive ocean freight rates."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {ports.map((port) => (
          <div class="p-6 rounded-2xl bg-white border border-[#E8E5DC] shadow-sm hover:shadow-md transition-all space-y-3">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-lg font-bold text-[#102C50]">{port.name}</h3>
                <span class="text-xs text-[#91753C] font-semibold">{port.location}</span>
              </div>
              <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-[#102C50] text-[#CBB482] uppercase">
                Active Gateway
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {port.facilities}
            </p>
            <div class="pt-2 text-xs text-slate-500 bg-[#F8F7F3] p-2.5 rounded-lg border border-[#E8E5DC]">
              <span class="font-bold text-slate-700">Specialized Cargo:</span> {port.cargoType}
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Incoterms & Documentation Grid -->
  <section class="py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B69A63]/10 text-[#91753C] text-xs font-bold uppercase tracking-wider">
            International Compliance
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#102C50] leading-tight">
            Complete Export Documentation Kit
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Every export shipment is accompanied by a complete, legally authenticated documentation dossier to ensure effortless customs clearance at the destination port:
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#B69A63]"></span>
              <span><strong>Clean On Board Ocean Bill of Lading (B/L)</strong> or Multimodal Air Waybill</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#B69A63]"></span>
              <span><strong>Certificate of Origin (COO)</strong> legalized by the Chamber of Commerce</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#B69A63]"></span>
              <span><strong>Phytosanitary Certificate (PSC)</strong> issued by Govt. of India Plant Quarantine</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#B69A63]"></span>
              <span><strong>SGS / Intertek Independent Inspection Certificate</strong> of Quality &amp; Weight</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#B69A63]"></span>
              <span><strong>Fumigation &amp; Non-GMO Certificates</strong> as mandated by destination customs</span>
            </li>
          </ul>
          <div class="pt-4">
            <Button href="/contact" variant="primary" size="md">
              Request Export Quotation &rarr;
            </Button>
          </div>
        </div>

        <div class="p-8 rounded-2xl bg-[#102C50] text-white space-y-6 shadow-xl">
          <h3 class="text-2xl font-bold text-[#CBB482]">Supported Incoterms 2020</h3>
          <div class="space-y-4 text-xs sm:text-sm text-slate-200">
            <div class="border-b border-slate-700 pb-3">
              <div class="font-bold text-white text-base">FOB (Free On Board)</div>
              <p class="text-slate-300 mt-1">We deliver goods cleared for export loaded on board the vessel nominated by the buyer at Indian ports (JNPT / Mundra / Hazira).</p>
            </div>
            <div class="border-b border-slate-700 pb-3">
              <div class="font-bold text-white text-base">CIF (Cost, Insurance &amp; Freight)</div>
              <p class="text-slate-300 mt-1">We arrange ocean freight and marine cargo insurance up to the buyer’s designated discharge port worldwide.</p>
            </div>
            <div>
              <div class="font-bold text-white text-base">CFR (Cost &amp; Freight)</div>
              <p class="text-slate-300 mt-1">We cover freight costs to the destination port, allowing buyers to manage their local marine insurance policies.</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
