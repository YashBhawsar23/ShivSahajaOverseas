---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import AboutIntro from '../components/home/AboutIntro.astro';
import FeaturedProducts from '../components/home/FeaturedProducts.astro';
import CapabilitiesSection from '../components/home/CapabilitiesSection.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import CertificationsPreview from '../components/home/CertificationsPreview.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
import JsonLd from '../components/seo/JsonLd.astro';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Corporation',
  name: 'Shivsahaja Overseas',
  legalName: 'Shivsahaja Overseas',
  url: 'https://shivsahajaoverseas.com',
  logo: 'https://shivsahajaoverseas.com/images/og-banner.png',
  description: 'Premier Indian agricultural export enterprise supplying verified fresh fruits, vegetables, spices, grains, pulses, and cotton.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Indore',
    addressRegion: 'Madhya Pradesh',
    postalCode: '452001',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+91-99770-28934',
    contactType: 'sales',
    availableLanguage: ['English', 'Hindi'],
  },
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Shivsahaja Overseas',
  url: 'https://shivsahajaoverseas.com',
};
---

<BaseLayout
  title="Shivsahaja Overseas | Indian Agricultural Exports"
  description="Shivsahaja Overseas is a premier Indian export and trading house supplying verified fresh fruits and vegetables, spices, pulses, grains, and raw cotton worldwide."
>
  <JsonLd slot="head" schema={organizationSchema} />
  <JsonLd slot="head" schema={webSiteSchema} />
  <!-- 2. Hero Section -->
  <HeroSection />

  <!-- 3. Product Category Cards -->
  <CategoryGrid />

  <!-- 4. About Us Introduction -->
  <AboutIntro />

  <!-- 5. Featured Products from Content Collections -->
  <FeaturedProducts />

  <!-- 6. Business Capabilities & Features -->
  <CapabilitiesSection />

  <!-- 7. Why Choose Us -->
  <WhyChooseUs />

  <!-- 8. Certifications Preview -->
  <CertificationsPreview />

  <!-- 9. FAQ Accordion -->
  <FaqAccordion />

  <!-- 10. Contact CTA -->
  <ContactCtaSection />

  <!-- Note: Section 1 (Header) & Section 11 (Footer) are provided by BaseLayout -->
  <!-- Note: Testimonials section remains strictly hidden until genuine client feedback is supplied -->
</BaseLayout>
