---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import AboutIntro from '../components/home/AboutIntro.astro';
import FeaturedProducts from '../components/home/FeaturedProducts.astro';
import CapabilitiesSection from '../components/home/CapabilitiesSection.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import CertificationsPreview from '../components/home/CertificationsPreview.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import ContactCtaSection from '../components/home/ContactCtaSection.astro';
---

<BaseLayout
  title="Connecting Global Markets Through Trusted Trade"
  description="Shivsahaja Overseas is a premier Indian export and trading house supplying verified fresh fruits and vegetables, spices, pulses, grains, and raw cotton worldwide."
>
  <!-- 2. Hero Section -->
  <HeroSection />

  <!-- 3. Product Category Cards -->
  <CategoryGrid />

  <!-- 4. About Us Introduction -->
  <AboutIntro />

  <!-- 5. Featured Products from Content Collections -->
  <FeaturedProducts />

  <!-- 6. Business Capabilities & Features -->
  <CapabilitiesSection />

  <!-- 7. Why Choose Us -->
  <WhyChooseUs />

  <!-- 8. Certifications Preview -->
  <CertificationsPreview />

  <!-- 9. FAQ Accordion -->
  <FaqAccordion />

  <!-- 10. Contact CTA -->
  <ContactCtaSection />

  <!-- Note: Section 1 (Header) & Section 11 (Footer) are provided by BaseLayout -->
  <!-- Note: Testimonials section remains strictly hidden until genuine client feedback is supplied -->
</BaseLayout>
