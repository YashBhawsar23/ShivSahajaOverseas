---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import ProductGallery from '../../components/products/ProductGallery.astro';
import ProductDetails from '../../components/products/ProductDetails.astro';
import ProductEnquiryCTA from '../../components/products/ProductEnquiryCTA.astro';
import RelatedProducts from '../../components/products/RelatedProducts.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { getAllProducts, getCategoryDetails } from '../../utils/products';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const categoryInfo = getCategoryDetails(data.category);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: data.shortDescription,
  image: data.image.startsWith('http') ? data.image : `https://shivsahajaoverseas.com${data.image}`,
  category: categoryInfo?.name || data.category,
  brand: {
    '@type': 'Brand',
    name: 'Shivsahaja Overseas',
  },
  sku: data.hsCode || data.slug,
  mpn: data.hsCode || data.slug,
  countryOfOrigin: {
    '@type': 'Country',
    name: 'India',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: '0.00',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '0.00',
      priceCurrency: 'USD',
      name: 'Commercial wholesale rate on application (Incoterms: FOB / CIF / CFR)',
    },
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      name: 'Shivsahaja Overseas',
    },
    description: 'B2B commercial wholesale quotation available upon inquiry based on Incoterms (FOB/CIF/CFR).',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://shivsahajaoverseas.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Products',
      item: 'https://shivsahajaoverseas.com/products',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryInfo?.name || data.category,
      item: `https://shivsahajaoverseas.com/products/category/${data.category}`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: data.name,
      item: `https://shivsahajaoverseas.com/products/${data.slug}`,
    },
  ],
};

const defaultPhone = '919977028934';
const waMessage = data.hsCode
  ? `Hello Shivsahaja Overseas, I am interested in a commercial price quotation for ${data.name} (HS Code: ${data.hsCode}). Please share current FOB/CIF availability, export grading, and pricing.`
  : `Hello Shivsahaja Overseas, I am interested in a commercial price quotation for ${data.name}. Please share current FOB/CIF availability, export grading, and pricing.`;
const whatsappUrl = `https://wa.me/${defaultPhone}?text=${encodeURIComponent(waMessage)}`;
---

<BaseLayout
  title={data.seo.title || `${data.name} Exporter India`}
  description={data.seo.description || data.shortDescription}
  image={data.image}
  type="product"
  hasBottomBar={true}
  hideFloatingWhatsApp={true}
>
  <JsonLd slot="head" schema={productSchema} />
  <JsonLd slot="head" schema={breadcrumbSchema} />

  <!-- Breadcrumbs Strip -->
  <div class="bg-white border-b border-[#E8E5DC] py-2.5 sm:py-3.5">
    <Container>
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-[#102C50] transition-colors">Home</a>
        <span class="text-slate-300">&rsaquo;</span>
        <a href="/products" class="hover:text-[#102C50] transition-colors">Products</a>
        <span class="text-slate-300">&rsaquo;</span>
        <a href={`/products/category/${data.category}`} class="hover:text-[#102C50] transition-colors">
          {categoryInfo?.name || data.category}
        </a>
        <span class="text-slate-300">&rsaquo;</span>
        <span class="text-[#102C50] font-semibold truncate max-w-[200px] sm:max-w-xs">{data.name}</span>
      </nav>
    </Container>
  </div>

  <!-- Product Detail Core -->
  <section class="py-6 sm:py-12 pb-24 lg:pb-12 bg-[#F8F7F3] border-b border-[#E8E5DC]">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-14 items-start">
        <!-- Left: Image Gallery & (Desktop-only) Sticky Quotation CTA -->
        <div class="lg:col-span-5 space-y-6 sm:space-y-8 lg:sticky lg:top-28">
          <ProductGallery
            mainImage={data.image}
            gallery={data.gallery}
            productName={data.name}
          />

          <!-- Desktop Sticky Quotation CTA -->
          <div class="hidden lg:block">
            <ProductEnquiryCTA
              productName={data.name}
              moq={data.moq}
              hsCode={data.hsCode}
            />
          </div>
        </div>

        <!-- Right: Technical Details, Agronomy/Logistics, & Mobile Quotation CTA -->
        <div class="lg:col-span-7 space-y-6 sm:space-y-8">
          <ProductDetails product={product} />

          <!-- Rendered Markdown Body (Processing, Harvest & Agronomy Logistics) -->
          <div class="bg-white p-5 sm:p-7 rounded-2xl border border-[#E8E5DC] shadow-sm prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-[#102C50] prose-a:text-[#102C50] prose-a:underline hover:prose-a:text-[#B69A63]">
            <div class="not-prose inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold bg-[#B69A63]/15 text-[#91753C] uppercase tracking-wider mb-2">
              Commodity Insights & Logistics
            </div>
            <Content />
          </div>

          <!-- Mobile-only Quotation CTA (placed as primary conversion point after all details) -->
          <div class="lg:hidden scroll-mt-24" id="product-inquiry">
            <ProductEnquiryCTA
              productName={data.name}
              moq={data.moq}
              hsCode={data.hsCode}
            />
          </div>
        </div>
      </div>

      <!-- Related Products in Same Category -->
      <RelatedProducts
        currentSlug={data.slug}
        category={data.category}
      />
    </Container>
  </section>

  <!-- Sticky Mobile Action Bottom Bar -->
  <aside
    class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#E8E5DC] px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom,0px))] shadow-[0_-4px_20px_rgba(0,0,0,0.08)] transition-transform duration-300"
    aria-label="Quick Commodity Inquiry Bar"
  >
    <div class="flex items-center justify-between gap-3 max-w-lg mx-auto">
      <div class="min-w-0 flex-1">
        <span class="block text-xs font-bold text-[#102C50] truncate">{data.name}</span>
        <span class="block text-[11px] text-slate-500 font-medium truncate">
          {data.moq ? `MOQ: ${data.moq}` : 'Export Standard Quality'}
        </span>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center p-2 rounded-lg bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-sm transition-colors"
          aria-label={`Inquire about ${data.name} on WhatsApp`}
          title="Inquire on WhatsApp"
        >
          <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z" />
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 001.333 4.993L2 22l5.233-1.237a9.994 9.994 0 004.779 1.217h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.669-1.037-5.176-2.925-7.062A9.925 9.925 0 0012.012 2zm0 18.234h-.003a8.28 8.28 0 01-4.223-1.152l-.303-.18-3.111.737.747-3.033-.197-.314a8.257 8.257 0 01-1.267-4.298c.001-4.571 3.725-8.291 8.303-8.291 2.214 0 4.295.863 5.86 2.428a8.243 8.243 0 012.425 5.864c-.001 4.572-3.725 8.291-8.298 8.291z" />
          </svg>
        </a>

        <a
          href={`/contact?commodity=${encodeURIComponent(data.name)}`}
          class="inline-flex items-center justify-center p-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#102C50] transition-colors"
          aria-label="Direct Contact Form"
          title="Direct Contact"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

        <a
          href="#product-inquiry"
          class="inline-flex items-center justify-center gap-1 px-4 py-2 rounded-lg bg-[#B69A63] hover:bg-[#A38752] text-[#102C50] text-xs font-extrabold shadow-sm uppercase tracking-wider transition-colors"
        >
          <span>Inquire Now</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </aside>
</BaseLayout>
