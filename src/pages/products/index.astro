---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import ProductCategoryNavigation from '../../components/products/ProductCategoryNavigation.astro';
import ProductFilterBar from '../../components/products/ProductFilterBar.astro';
import ProductGrid from '../../components/products/ProductGrid.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { getAllProducts } from '../../utils/products';
import { SITE_CONFIG } from '../../config/site';

const allProducts = await getAllProducts();
const { enableImport } = SITE_CONFIG.features;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://shivsahajaoverseas.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Products',
      item: 'https://shivsahajaoverseas.com/products',
    },
  ],
};
---

<BaseLayout
  title="Product Catalogue | Indian Agro Commodities & Cotton"
  description="Browse Shivsahaja Overseas complete export catalogue: fresh Indian fruits and vegetables, pure spices, non-GMO pulses, food grains, and raw cotton."
>
  <JsonLd slot="head" schema={breadcrumbSchema} />

  <!-- Hero Header -->
  <section class="py-16 bg-gradient-to-b from-[#102C50] to-[#183B63] text-white">
    <Container>
      <div class="max-w-3xl">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-300 mb-4">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>&rsaquo;</span>
          <span class="text-[#CBB482] font-semibold">Product Catalogue</span>
        </nav>

        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482] text-xs font-bold uppercase tracking-wider mb-4">
          Data-Driven B2B Trade Catalogue
        </span>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          {enableImport ? 'Export & Import' : 'Global Export'} <span class="text-[#B69A63]">Commodity Directory</span>
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-200 leading-relaxed font-light">
          Explore our certified fresh horticultural produce, aromatic spices, pulses, food grains, and raw cotton varieties prepared for global containerized freight.
        </p>
      </div>
    </Container>
  </section>

  <!-- Main Catalogue Explorer -->
  <section class="py-14 bg-[#F8F7F3] border-b border-[#E8E5DC]">
    <Container>
      <!-- Category Navigation Pills -->
      <div class="mb-8">
        <ProductCategoryNavigation activeCategory="all" />
      </div>

      <!-- Live Search & Trade Type Filter Bar -->
      <ProductFilterBar />

      <!-- Complete Product Grid -->
      <ProductGrid products={allProducts} />

      <!-- Sourcing Assistance Card -->
      <div class="mt-16 p-8 rounded-2xl bg-white border border-[#E8E5DC] shadow-sm max-w-4xl mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#102C50] text-[#CBB482] uppercase tracking-wider">
          Custom Sourcing Requisitions
        </div>
        <h3 class="text-2xl font-bold text-[#102C50]">
          Require a Specific Commodity, Mesh Size, or Origin?
        </h3>
        <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
          Through our extensive network of farmgate mandis, ginning plants, and cold storages across western and central India, we fulfill customized bulk orders tailored to your exact chemical and physical parameters.
        </p>
        <div class="pt-2">
          <a
            href="/contact"
            class="inline-flex items-center px-6 py-3 rounded-lg bg-[#102C50] text-white hover:bg-[#183B63] font-semibold text-sm transition-all shadow hover:shadow-md"
          >
            Submit Custom Sourcing Request &rarr;
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
