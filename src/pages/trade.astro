---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/common/Button.astro';

const supplyPillars = [
  {
    icon: 'origin',
    tag: 'Stage 1: Origin Procurement',
    title: 'Farm-Gate & APMC Cluster Procurement',
    desc: 'Direct procurement networks across prime agricultural clusters in Maharashtra (Nashik, Solapur), Gujarat (Saurashtra, Kutch), Rajasthan, and Punjab. Commodities are evaluated at the farm-gate for physiological maturity, natural sugar brix, moisture equilibrium, and staple length before moving to consolidation centers.',
    highlights: ['Zero intermediate broker markups', 'Farm-level traceability & batch coding', 'HortiNet APEDA registered growers'],
  },
  {
    icon: 'sortex',
    tag: 'Stage 2: Processing & Refining',
    title: 'Sortex Optical Grading & Mechanical Cleaning',
    desc: 'Raw agricultural lots pass through multi-stage pre-cleaners, gravity destoners, aspiration chambers, and state-of-the-art Sortex trichromatic optical sorters. Foreign matter, broken grains, discolored seeds, and pinhead impurities are eliminated to achieve commercial purity up to 99.5%.',
    highlights: ['Sortex optical color separation', 'Magnetic & metal separation arrays', 'Standardized grading (FSSAI/AGMARK)'],
  },
  {
    icon: 'coldchain',
    tag: 'Stage 3: Temperature Control',
    title: 'Cold-Chain Integrity & Reefer Logistics',
    desc: 'Perishable fruits and vegetables (such as Fresh Onions, Bhagwa Pomegranates, Badam Mangoes, and Cavendish Bananas) are immediately transferred into forced-air pre-cooling chambers and maintained in temperature-regulated reefer containers (+1°C to +3°C, 65-70% RH) equipped with active electronic temperature data loggers.',
    highlights: ['Pre-cooling within hours of harvest', 'Continuous USB temperature loggers', 'Atmosphere & humidity management'],
  },
  {
    icon: 'packaging',
    tag: 'Stage 4: Packaging & Handling',
    title: 'Preservation Packaging & Export Stenciling',
    desc: 'Packaging engineered to withstand prolonged maritime transit across global sea routes. We utilize ventilated CFB cartons with pulp cavity trays, breathable leno mesh bags, multi-wall Kraft paper sacks, and food-grade HDPE woven bags. Fully customizable with private-label buyer branding and barcoding.',
    highlights: ['Palletized & stretch-wrapped units', 'Desiccant packs & anti-humidity liners', 'Private-label stenciling supported'],
  },
];

const tradeSteps = [
  {
    step: '01',
    title: 'Commercial Inquiry & Technical Alignment',
    desc: 'Buyer communicates required commodity, grade specifications (moisture, purity, count, color, brix), target volume, packaging preferences, and discharge port. Our trade desk provides an itemized commercial quotation.',
    badge: 'Initial Alignment',
  },
  {
    step: '02',
    title: 'Contract Execution & Financial Security',
    desc: 'Formalization of the international sales contract under ICC Incoterms 2020 rules. Payment structures secured through Irrevocable Letter of Credit (L/C at sight) or advance Telegraphic Wire Transfer (T/T).',
    badge: 'Legal & Banking',
  },
  {
    step: '03',
    title: 'Precision Sourcing & Batch Quality Control',
    desc: 'Procurement initiated across audited grower networks and ginning clusters. Raw lots are cleaned, Sortex-graded, and containerized under strict batch tracking and phytosanitary supervision.',
    badge: 'Processing SOP',
  },
  {
    step: '04',
    title: 'Independent Pre-Shipment Inspection',
    desc: 'Mandatory physical verification and laboratory testing by globally accredited inspection surveyors (SGS, Intertek, or Geo-Chem) validating gross weight, tare weight, moisture percentage, and container hygiene.',
    badge: 'Third-Party Verified',
  },
  {
    step: '05',
    title: 'Customs Clearance & Vessel Stowing',
    desc: 'Drayage to primary maritime gateways (JNPT, Mundra, Hazira). Rapid customs clearance, port terminal handling, export documentation processing, and monitored container stowage aboard scheduled ocean carriers.',
    badge: 'Port Logistics',
  },
  {
    step: '06',
    title: 'Swift Documentation Dossier Dispatch',
    desc: 'Original negotiable Bill of Lading (B/L), Certificate of Origin (COO), Commercial Invoice, Packing List, Phytosanitary Certificate, and Marine Insurance policy dispatched via express air courier and digital portals.',
    badge: 'Title Transfer',
  },
];

const ports = [
  {
    name: 'JNPT (Nhava Sheva Port, Mumbai)',
    location: 'Maharashtra, India',
    facilities: "India's largest premier container gateway; direct scheduled vessel calls to Gulf (Jebel Ali, Dammam), Europe (Rotterdam, Antwerp), and Mediterranean destinations.",
    cargoType: 'Standard 20ft/40ft Dry containers, Flat rack cotton bales, Reefer containers',
    advantage: 'Proximity to Maharashtra onion, pomegranate, and grape horticultural belts',
  },
  {
    name: 'Mundra Port',
    location: 'Gulf of Kutch, Gujarat',
    facilities: 'Deep-draft commercial port with high-speed automated gantry cranes, extensive temperature-regulated cold storage, and private railway siding.',
    cargoType: 'Food grains, Oilseeds, Cumin & Spices, Perishable fresh produce',
    advantage: 'Rapid turnaround times and extensive connectivity to Western Asian trade routes',
  },
  {
    name: 'Hazira Port (Surat)',
    location: 'Gujarat, India',
    facilities: 'State-of-the-art container terminal situated close to southern Gujarat industrial parks and northern Maharashtra agrarian zones.',
    cargoType: 'Agricultural produce, Cotton bales & slivers, Processed flour & grains',
    advantage: 'Direct arterial access to major cotton ginning and grain milling centers',
  },
  {
    name: 'Chennai & Cochin Ports',
    location: 'Southern India Gateways',
    facilities: 'Strategic maritime access points for South Indian spices, whole turmeric fingers, cardamom, and specialty tropical agricultural commodities.',
    cargoType: 'Whole & ground spices, Tropical pulses, Seed commodities',
    advantage: 'Direct feeder connectivity to Southeast Asian and Far Eastern markets',
  },
];

const tradeMetrics = [
  { label: 'Export Commodities', value: '24+', detail: 'Standardized specifications' },
  { label: 'Maritime Gateways', value: '4 Ports', detail: 'JNPT, Mundra, Hazira, Chennai' },
  { label: 'Quality Verification', value: '100%', detail: 'SGS / Intertek tested' },
  { label: 'Contract Rules', value: 'Incoterms', detail: 'FOB, CIF, CFR supported' },
];
---

<BaseLayout
  title="Global Trade Operations & Supply Network | Shivsahaja Overseas"
  description="Explore Shivsahaja Overseas global trade operations: farm-to-port agro commodity procurement, Sortex processing, cold chain logistics, SGS verification, and deepwater maritime gateways across India."
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-24 bg-gradient-to-b from-[#102C50] via-[#14345C] to-[#183B63] text-white relative overflow-hidden">
    <!-- Background subtle graphic accents -->
    <div class="absolute inset-0 bg-[radial-gradient(#B69A63_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>
    <div class="absolute -right-24 -top-24 w-96 h-96 bg-[#B69A63]/10 rounded-full blur-3xl pointer-events-none"></div>

    <Container class="relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#B69A63]/20 border border-[#B69A63]/40 text-[#CBB482] text-xs font-bold uppercase tracking-wider mb-5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Institutional Global Supply Operations
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15]">
          Connecting Indian Agriculture to <span class="text-[#B69A63]">Global Markets</span>
        </h1>
        
        <p class="mt-5 text-base sm:text-lg text-slate-200 leading-relaxed font-light">
          Shivsahaja Overseas operates a disciplined, end-to-end commodity trade network engineered for international B2B buyers, food processors, and trading houses. From origin farm procurement and Sortex optical grading to cold-chain preservation and multimodal port dispatch, we deliver consistency at scale.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button href="/products" variant="gold" size="lg" class="shadow-lg">
            Explore 24+ Commodities &rarr;
          </Button>
          <Button href="/contact" variant="outline" size="lg" class="border-white/30 text-white hover:bg-white/10">
            Contact Trade Desk
          </Button>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="mt-14 pt-10 border-t border-white/15 grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        {tradeMetrics.map((m) => (
          <div class="border-l-2 border-[#B69A63] pl-4">
            <span class="block text-2xl sm:text-3xl font-extrabold text-[#CBB482] font-mono">{m.value}</span>
            <span class="block text-xs sm:text-sm font-bold text-white mt-0.5">{m.label}</span>
            <span class="block text-[11px] text-slate-300 mt-0.5">{m.detail}</span>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Supply Chain Architecture: Farm to Port -->
  <section class="py-16 sm:py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Supply Chain Architecture"
        title="From Farm Gate to Maritime Vessel"
        subtitle="A transparent, quality-controlled infrastructure eliminating intermediate trade friction and safeguarding commodity integrity."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        {supplyPillars.map((pillar) => (
          <div class="p-6 sm:p-8 rounded-2xl bg-[#F8F7F3] border border-[#E8E5DC] hover:border-[#B69A63] hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold bg-[#102C50] text-[#CBB482] uppercase tracking-wider">
                  {pillar.tag}
                </span>
                <span class="w-8 h-8 rounded-full bg-[#B69A63]/15 text-[#91753C] flex items-center justify-center font-bold text-xs group-hover:bg-[#B69A63] group-hover:text-white transition-colors">
                  &check;
                </span>
              </div>

              <h3 class="text-xl font-bold text-[#102C50] mb-3 leading-snug">
                {pillar.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {pillar.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-200/70">
              <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Core Competencies:</span>
              <ul class="space-y-1.5">
                {pillar.highlights.map((h) => (
                  <li class="flex items-center gap-2 text-xs font-semibold text-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B69A63] flex-shrink-0"></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 6-Stage Standard Execution Protocol -->
  <section class="py-16 sm:py-20 bg-[#F8F7F3] border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Standard Operating Protocol"
        title="Our 6-Stage Trade Execution Process"
        subtitle="A repeatable, contract-compliant framework governing every container dispatched from Indian ports."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mt-12">
        {tradeSteps.map((step) => (
          <div class="p-6 sm:p-7 rounded-2xl bg-white border border-[#E8E5DC] flex flex-col justify-between hover:border-[#B69A63] hover:shadow-lg transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl font-black text-[#B69A63] font-mono">{step.step}</span>
                <span class="text-[10px] font-bold text-[#102C50] bg-[#F8F7F3] px-2.5 py-1 rounded border border-[#E8E5DC] uppercase tracking-wider">
                  {step.badge}
                </span>
              </div>
              <h3 class="text-lg font-bold text-[#102C50] mb-2 leading-snug">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {step.desc}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Quality Assurance Verified</span>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Maritime Port Gateways -->
  <section class="py-16 sm:py-20 bg-white border-b border-[#E8E5DC]">
    <Container>
      <SectionHeader
        badge="Maritime Gateways"
        title="Primary Ports of Loading Across India"
        subtitle="Strategic access to India's major deepwater terminals guarantees regular vessel schedules, competitive freight, and rapid turnaround times."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto mt-12">
        {ports.map((port) => (
          <div class="p-6 sm:p-7 rounded-2xl bg-[#F8F7F3] border border-[#E8E5DC] shadow-sm hover:shadow-md hover:border-[#B69A63] transition-all space-y-4">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="text-lg font-bold text-[#102C50]">{port.name}</h3>
                <span class="text-xs text-[#91753C] font-semibold">{port.location}</span>
              </div>
              <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-[#102C50] text-[#CBB482] uppercase flex-shrink-0">
                Active Gateway
              </span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {port.facilities}
            </p>

            <div class="pt-2 text-xs text-slate-600 bg-white p-3 rounded-xl border border-[#E8E5DC] space-y-1.5">
              <div>
                <span class="font-bold text-[#102C50]">Cargo Specialization:</span> {port.cargoType}
              </div>
              <div class="text-slate-500 text-[11px]">
                <span class="font-semibold text-slate-700">Strategic Advantage:</span> {port.advantage}
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Incoterms 2020 & Documentation Kit -->
  <section class="py-16 sm:py-20 bg-[#F8F7F3] border-b border-[#E8E5DC]">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Documentation Dossier (Left 7 cols) -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B69A63]/15 text-[#91753C] text-xs font-bold uppercase tracking-wider">
            International Trade Compliance
          </div>
          
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#102C50] leading-tight">
            Complete Legal Export Documentation Dossier
          </h2>
          
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Every export consignment dispatched by Shivsahaja Overseas is accompanied by a comprehensive, authenticated documentation suite to ensure prompt customs clearance and title transfer at destination ports:
          </p>

          <ul class="space-y-3 text-xs sm:text-sm text-slate-700 pt-2">
            <li class="flex items-start gap-2.5 bg-white p-3 rounded-xl border border-[#E8E5DC]">
              <span class="w-2 h-2 rounded-full bg-[#B69A63] mt-1.5 flex-shrink-0"></span>
              <div>
                <strong>Clean On Board Ocean Bill of Lading (B/L)</strong>: Issued by accredited shipping lines as definitive receipt of cargo and title document.
              </div>
            </li>
            <li class="flex items-start gap-2.5 bg-white p-3 rounded-xl border border-[#E8E5DC]">
              <span class="w-2 h-2 rounded-full bg-[#B69A63] mt-1.5 flex-shrink-0"></span>
              <div>
                <strong>Certificate of Origin (COO)</strong>: Legalized by the Chamber of Commerce, validating genuine Indian origin for preferential tariff treatment.
              </div>
            </li>
            <li class="flex items-start gap-2.5 bg-white p-3 rounded-xl border border-[#E8E5DC]">
              <span class="w-2 h-2 rounded-full bg-[#B69A63] mt-1.5 flex-shrink-0"></span>
              <div>
                <strong>Phytosanitary Certificate (PSC)</strong>: Issued by the Plant Quarantine Organization of India, certifying pest-free compliance.
              </div>
            </li>
            <li class="flex items-start gap-2.5 bg-white p-3 rounded-xl border border-[#E8E5DC]">
              <span class="w-2 h-2 rounded-full bg-[#B69A63] mt-1.5 flex-shrink-0"></span>
              <div>
                <strong>SGS / Intertek Independent Inspection Certificate</strong>: Neutral third-party verification of gross/tare weight, moisture, and quality parameters.
              </div>
            </li>
            <li class="flex items-start gap-2.5 bg-white p-3 rounded-xl border border-[#E8E5DC]">
              <span class="w-2 h-2 rounded-full bg-[#B69A63] mt-1.5 flex-shrink-0"></span>
              <div>
                <strong>Commercial Invoice, Packing List &amp; Fumigation Certificate</strong>: Complete legal packing and treatment documentation.
              </div>
            </li>
          </ul>
        </div>

        <!-- Incoterms 2020 Card (Right 5 cols) -->
        <div class="lg:col-span-5 p-7 sm:p-8 rounded-2xl bg-[#102C50] text-white space-y-6 shadow-2xl relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-[#B69A63]/15 rounded-full blur-2xl pointer-events-none"></div>

          <div>
            <span class="text-xs font-bold text-[#CBB482] uppercase tracking-wider block mb-1">Commercial Terms</span>
            <h3 class="text-2xl font-bold text-white">Supported Incoterms 2020</h3>
          </div>

          <div class="space-y-4 text-xs sm:text-sm text-slate-200 divide-y divide-slate-700/80">
            <div class="pt-1 pb-4">
              <div class="font-bold text-[#CBB482] text-base flex items-center justify-between">
                <span>FOB (Free On Board)</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-white/10 text-slate-300">Indian Ports</span>
              </div>
              <p class="text-slate-300 mt-1 leading-relaxed text-xs">
                We deliver goods cleared for export loaded on board the vessel nominated by the buyer at Indian ports (JNPT, Mundra, or Hazira).
              </p>
            </div>

            <div class="py-4">
              <div class="font-bold text-[#CBB482] text-base flex items-center justify-between">
                <span>CIF (Cost, Insurance &amp; Freight)</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-white/10 text-slate-300">Global Destination</span>
              </div>
              <p class="text-slate-300 mt-1 leading-relaxed text-xs">
                We contract and pay for ocean freight and marine cargo insurance up to the buyer’s designated discharge port worldwide.
              </p>
            </div>

            <div class="pt-4">
              <div class="font-bold text-[#CBB482] text-base flex items-center justify-between">
                <span>CFR (Cost &amp; Freight)</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-white/10 text-slate-300">Flexible Insurance</span>
              </div>
              <p class="text-slate-300 mt-1 leading-relaxed text-xs">
                We cover ocean freight costs to the destination port, allowing international buyers to utilize their local marine insurance underwriters.
              </p>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-700">
            <a
              href="/contact?subject=Commercial%20Incoterms%20Inquiry"
              class="w-full inline-flex items-center justify-center px-5 py-3 rounded-xl bg-[#B69A63] hover:bg-[#A38752] text-[#102C50] text-xs font-extrabold uppercase tracking-wider shadow-md transition-colors"
            >
              Request Commercial Incoterms Quote &rarr;
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Final Trade Desk Call to Action -->
  <section class="py-16 sm:py-20 bg-gradient-to-r from-[#102C50] to-[#183B63] text-white">
    <Container class="text-center">
      <div class="max-w-2xl mx-auto space-y-5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#B69A63]/20 text-[#CBB482] uppercase tracking-wider">
          Direct Commercial Inquiries
        </span>

        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
          Partner with a Transparent, Quality-First Indian Exporter
        </h2>

        <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light">
          Whether you need containerized agro perishables in refrigerated containers or bulk raw cotton bales, our trade operations desk provides formal Proforma Invoices within 24 business hours.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/contact" variant="gold" size="lg" class="w-full sm:w-auto shadow-lg">
            Submit Trade Inquiry &rarr;
          </Button>
          <a
            href="mailto:enquiry@shivsahajaoverseas.com"
            class="text-xs sm:text-sm text-slate-300 hover:text-white transition-colors underline-offset-4 hover:underline py-2"
          >
            Direct Email: enquiry@shivsahajaoverseas.com
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
